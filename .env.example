# ================================================================
# GIMMIE SHOPIFY SUBSCRIPTION MEAL BUILDER - ENVIRONMENT CONFIG
# ================================================================

# Port for local server
PORT=3000

# Shopify Store Domain (e.g. gimmie.co.uk or iknacn-wq.myshopify.com)
SHOPIFY_SHOP_DOMAIN=iknacn-wq.myshopify.com

# Shopify Admin API Access Token (Starts with shpat_...)
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_your_admin_api_token_here

# Shopify App Secret Key (From Shopify Partner Dashboard / Custom App settings for HMAC validation)
SHOPIFY_API_SECRET_KEY=your_shopify_app_api_secret_key_here

# Shopify Admin API Version
SHOPIFY_API_VERSION=2024-07

# Weekly Menu Configuration
# Option 1: Handle of the collection containing this week's meals (e.g. "meals", "current-menu", or "next-week")
MENU_COLLECTION_HANDLE=meals

# Option 2: Tag filter for rotating menus (optional, e.g. "week-36" or "menu-active")
MENU_TAG_FILTER=

# Weekly Cutoff Day (0 = Sunday, 1 = Monday, 2 = Tuesday, 3 = Wednesday, 4 = Thursday, 5 = Friday, 6 = Saturday)
WEEKLY_CUTOFF_DAY=3
WEEKLY_CUTOFF_HOUR_UTC=23
