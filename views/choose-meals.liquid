          clearButton.style.display = (!isCutoffPassed && (items.length > 0 || state.totalAddons > 0)) ? 'inline-block' : 'none';
        }

        if (items.length === 0) {
          selectedListEl.innerHTML = '<p style="color: var(--gimmie-muted); font-size: 0.9rem; margin: 0;">No meals selected yet.</p>';
        } else {
          let html = '';
          items.forEach(([variantId, item]) => {
            const removeHtml = isCutoffPassed ? '' : `<span style="cursor: pointer; opacity: 0.7; font-size: 1.1rem;" data-remove-variant="${variantId}">&times;</span>`;
            html += `
              <div class="gimmie-build-box__selected-item">
                <span>${item.quantity} × ${item.title}</span>
                ${removeHtml}
              </div>
            `;
          });
          selectedListEl.innerHTML = html;

          if (!isCutoffPassed) {
            selectedListEl.querySelectorAll('[data-remove-variant]').forEach(btn => {
              btn.addEventListener('click', () => {
                const vId = btn.getAttribute('data-remove-variant');
                if (state.selections[vId]) {
                  delete state.selections[vId];
                  updateUI();
                }
              });
            });
          }
        }
      }

      // 2. Render Selected Add-ons in Sidebar
      if (summaryAddonsTotalEl) {
        if (state.totalAddonsPrice > 0) {
          if (state.totalAddonsOriginalPrice && state.totalAddonsPrice < state.totalAddonsOriginalPrice) {
            summaryAddonsTotalEl.innerHTML = `<span class="gimmie-compare-slashed" style="margin-right: 6px;">+£${state.totalAddonsOriginalPrice.toFixed(2)}</span><span>+£${state.totalAddonsPrice.toFixed(2)}</span>`;
          } else {
            summaryAddonsTotalEl.textContent = `+£${state.totalAddonsPrice.toFixed(2)}`;
          }
        } else {
          summaryAddonsTotalEl.textContent = '£0.00';
        }
      }

      if (selectedAddonsListEl) {
        const addonItems = Object.entries(state.addonSelections).filter(([_, item]) => item.quantity > 0);

        if (!state.addonsEnabled || addonItems.length === 0) {
          selectedAddonsListEl.innerHTML = '<p style="color: var(--gimmie-muted); font-size: 0.85rem; margin: 0;">No add-ons added (Optional).</p>';
        } else {
          let html = '';
          addonItems.forEach(([vId, item]) => {
            const removeHtml = isCutoffPassed ? '' : `<span style="cursor: pointer; opacity: 0.7; font-size: 1.1rem; margin-left: 6px;" data-remove-addon="${vId}">&times;</span>`;
            const itemPrice = (item.quantity * item.price).toFixed(2);
            html += `
              <div class="gimmie-build-box__selected-addon-row">
                <span>${item.quantity} × ${item.title}</span>
                <span style="display: flex; align-items: center; gap: 4px; font-weight: 800;">
                  <span>£${itemPrice}</span>
                  ${removeHtml}
                </span>
              </div>
            `;
          });
          selectedAddonsListEl.innerHTML = html;

          if (!isCutoffPassed) {
            selectedAddonsListEl.querySelectorAll('[data-remove-addon]').forEach(btn => {
              btn.addEventListener('click', () => {
                const aId = btn.getAttribute('data-remove-addon');
                if (state.addonSelections[aId]) {
                  delete state.addonSelections[aId];
                  updateUI();
                }
              });
            });
          }
        }
      }
    }

    function handleQuantityChange(variantId, change) {
      if (isCutoffPassed) {
        showStatus(`🔒 Cut-off passed on ${config.activeCutoffDate || 'Thu 11:59 PM UK'}. Your meals for delivery on ${config.formattedDeliveryDate} are locked for kitchen prep and cannot be changed.`, true);
        return;
      }
      const meal = meals.find(m => String(m.variantId) === String(variantId));
      if (!meal) return;

      if (!state.selections[variantId]) {
        state.selections[variantId] = {
          quantity: 0,
          title: meal.title,
          id: meal.id,
          variantId: meal.variantId
        };
      }

      const currentQty = state.selections[variantId].quantity;
      const newQty = Math.max(0, currentQty + change);

      if (change > 0 && state.totalSelected >= mealQuota) {
        showStatus(`⚠️ Your box is full (${mealQuota}/${mealQuota})! Please reduce (−) or remove an item first to add "${meal.title}".`, true);
        return;
      }

      if (newQty === 0) {
        delete state.selections[variantId];
      } else {
        state.selections[variantId].quantity = newQty;
      }

      updateUI();
    }

    function handleAddonQuantityChange(addonId, change) {
      if (isCutoffPassed) {
        showStatus('Cut-off passed. Order locked for kitchen prep.', true);
        return;
      }
      let addon = addons.find(a => String(a.variantId) === String(addonId) || String(a.id) === String(addonId));
      if (!addon) {
        const domCard = document.querySelector('[data-addon-id="' + addonId + '"], [data-addonmeal-id="' + addonId + '"], [data-meal-id="' + addonId + '"]');
        if (domCard) {
          const rawP = domCard.getAttribute('data-price') || domCard.getAttribute('data-addonmeal-price') || '8.00';
          let p = parseFloat(String(rawP).replace(/[^0-9.]/g, '')) || 8.00;
          if (p >= 100 && !String(rawP).includes('.')) p = p / 100;
          addon = {
            id: addonId,
            variantId: addonId,
            title: domCard.getAttribute('data-title') || domCard.getAttribute('data-addonmeal-title') || 'Add-on Meal',
            price: p
          };
          addons.push(addon);
        }
      }
      if (!addon) return;

      if (!state.addonSelections[addonId]) {
        const uPrice = parseFloat(addon.price) || 0;
        const origPrice = parseFloat(addon.originalPrice || addon.price) || uPrice;
        state.addonSelections[addonId] = {
          quantity: 0,
          title: addon.title,
          id: addon.id,
          variantId: addon.variantId,
          price: uPrice,
          originalPrice: origPrice,
          discountPercent: addon.discountPercent || (state.activeDiscount ? state.activeDiscount.percent : 0)
        };
      }

      const currentQty = state.addonSelections[addonId].quantity;
      const newQty = Math.max(0, Math.min(10, currentQty + change));

      if (newQty === 0) {
        delete state.addonSelections[addonId];
      } else {
        state.addonSelections[addonId].quantity = newQty;
      }

      updateUI();

      // Status text reserved for save confirmation
    }


    function openModal(itemId, triggerEl) {
      if (!modalEl) modalEl = document.getElementById('gimmie-nutrition-modal');
      if (!modalEl) return;

      let card = null;
      if (triggerEl && triggerEl.closest) {
        card = triggerEl.closest('.gimmie-build-box__meal, .gimmie-build-box__addon-item');
      }
      if (!card && itemId) {
        const allCards = document.querySelectorAll('.gimmie-build-box__meal, .gimmie-build-box__addon-item');
        for (const c of allCards) {
          if (c.getAttribute('data-meal-id') === String(itemId) || 
              c.getAttribute('data-addon-id') === String(itemId) || 
              c.getAttribute('data-addonmeal-id') === String(itemId) ||
              (c.getAttribute('data-title') && c.getAttribute('data-title').toLowerCase().trim() === String(itemId).toLowerCase().trim())) {
            card = c;
            break;
          }
        }
      }

      let item = allModalItems.find(m => 
        String(m.id) === String(itemId) || 
        String(m.variantId) === String(itemId) || 
        (m.title && itemId && m.title.toLowerCase().trim() === String(itemId).toLowerCase().trim())
