          if (parsed.addonsEnabled || Object.keys(savedAddons).length > 0) {
            state.addonsEnabled = true;
            Object.entries(savedAddons).forEach(([key, item]) => {
              if (item && item.quantity > 0) {
                const matchedAddon = validAddonMap.get(String(key)) || validAddonMap.get(item.title?.toLowerCase()?.trim());
