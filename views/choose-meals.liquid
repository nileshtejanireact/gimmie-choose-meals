{% render 'styles-inline' %}

{% raw %}
  {% unless customer %}
    <section class="gimmie-build-box" style="padding: 60px 20px; text-align: center;">
      <div style="max-width: 550px; margin: 0 auto; background: #fff; border: 2.5px solid #102b10; border-radius: 20px; padding: 40px 24px; box-shadow: 4px 4px 0 #102b10;">
        <div style="font-size: 3rem; margin-bottom: 16px;">🔐</div>
        <h2 style="font-size: 1.6rem; font-weight: 900; color: #102b10; margin-bottom: 12px; text-transform: uppercase;">
          Please Log In
        </h2>
        <p style="color: #444; font-size: 1.05rem; margin-bottom: 24px; line-height: 1.5;">
          Please log into your Gimmie account to manage and customize your weekly subscription box.
        </p>
        <a href="/account/login?return_url=/apps/choose-meals" class="gimmie-build-box__button" style="display: inline-block; padding: 14px 28px; background: #102b10; color: #fff; text-decoration: none; border-radius: 999px; font-weight: 800; font-size: 1rem;">
          Log In to Account
        </a>
      </div>
    </section>
  {% else %}
    {% assign is_subscriber = false %}
    {% assign is_paused = false %}
    {% assign customer_discount_tag = '' %}

    {% for tag in customer.tags %}
      {% assign down_tag = tag | downcase | strip %}
      {% if down_tag == 'paused' or down_tag == 'subscription-paused' or down_tag == 'inactive' or down_tag contains 'paused' %}
        {% assign is_paused = true %}
      {% endif %}
      {% if down_tag == 'active-subscriber' or down_tag == 'active_subscriber' or down_tag == 'active subscriber' or down_tag contains 'active-subscriber' or down_tag contains 'active_subscriber' or down_tag contains 'active subscriber' %}
        {% assign is_subscriber = true %}
      {% endif %}
      {% if down_tag contains 'discount-' or down_tag contains 'discount_' %}
        {% assign customer_discount_tag = down_tag %}
      {% endif %}
    {% endfor %}

    {% if is_paused %}
      <!-- 1. PAUSED SUBSCRIPTION SCREEN -->
      <section class="gimmie-build-box" style="padding: 60px 20px; text-align: center;">
        <div style="max-width: 580px; margin: 0 auto; background: #fff; border: 2.5px solid #102b10; border-radius: 20px; padding: 40px 24px; box-shadow: 4px 4px 0 #102b10;">
          <div style="display: inline-flex; align-items: center; justify-content: center; width: 68px; height: 68px; border: 2.5px solid #102b10; border-radius: 999px; background: #fff3cd; font-size: 2rem; font-weight: 900; margin-bottom: 20px;">
            ⏸️
          </div>
          <h1 style="font-size: 1.6rem; font-weight: 900; color: #102b10; margin-bottom: 12px; text-transform: uppercase;">
            Subscription Paused
          </h1>
          <p style="color: #444; font-size: 1.05rem; margin-bottom: 24px; line-height: 1.5;">
            Hi {{ customer.first_name | default: 'there' }}! Your weekly meal subscription is currently paused. Please unpause or reactivate your subscription in your account to choose your weekly meals.
          </p>
          <a href="/account" class="gimmie-build-box__button" style="display: inline-block; padding: 14px 28px; background: #102b10; color: #fff; text-decoration: none; border-radius: 999px; font-weight: 800; font-size: 1rem;">
            Manage Subscription in Account
          </a>
        </div>
      </section>
    {% elsif is_subscriber == false %}
      <!-- 2. NON-SUBSCRIBER SCREEN -->
      <section class="gimmie-build-box" style="padding: 60px 20px; text-align: center;">
        <div style="max-width: 580px; margin: 0 auto; background: #fff; border: 2.5px solid #102b10; border-radius: 20px; padding: 40px 24px; box-shadow: 4px 4px 0 #102b10;">
          <div style="display: inline-flex; align-items: center; justify-content: center; width: 68px; height: 68px; border: 2.5px solid #102b10; border-radius: 999px; background: #cce7c2; font-size: 2rem; font-weight: 900; margin-bottom: 20px;">
            🍽️
          </div>
          <h1 style="font-size: 1.6rem; font-weight: 900; color: #102b10; margin-bottom: 12px; text-transform: uppercase;">
            No Active Subscription Found
          </h1>
          <p style="color: #444; font-size: 1.05rem; margin-bottom: 24px; line-height: 1.5;">
            Hi {{ customer.first_name | default: 'there' }}! We couldn't find an active weekly subscription on your account (<strong>{{ customer.email }}</strong>). Start a meal plan to choose your meals each week.
          </p>
          <a href="/collections/all" class="gimmie-build-box__button" style="display: inline-block; padding: 14px 28px; background: #102b10; color: #fff; text-decoration: none; border-radius: 999px; font-weight: 800; font-size: 1rem;">
            View Meal Plans
          </a>
        </div>
      </section>
    {% else %}
      <!-- 3. ACTIVE SUBSCRIBER SCREEN (Choose Meals Builder) -->
      {% comment %} 1. Fetch Weekly Menu metaobject entries from Shopify {% endcomment %}
      {% assign meta_menus = shop.metaobjects.weekly_menu.values %}
      {% if meta_menus == blank or meta_menus.size == 0 %}
        {% assign meta_menus = shop.metaobjects.weekely_menu.values %}
      {% endif %}
      {% if meta_menus == blank or meta_menus.size == 0 %}
        {% assign meta_menus = shop.metaobjects.weekly_menus.values %}
      {% endif %}
      {% if meta_menus == blank or meta_menus.size == 0 %}
        {% assign meta_menus = shop.metaobjects.weeklymenu.values %}
      {% endif %}
      {% if meta_menus == blank or meta_menus.size == 0 %}
        {% assign meta_menus = shop.metaobjects.menu.values %}
      {% endif %}

      {% comment %} 2. Dynamically find the next UPCOMING menu (auto-skip any date that has already passed) {% endcomment %}
      {% assign now_ts = 'now' | date: '%s' | plus: 0 %}
      {% assign next_week_menu = nil %}
      {% assign min_future_diff = 9999999999 %}
      {% assign fallback_recent_menu = nil %}
      {% assign min_past_diff = 9999999999 %}

      {% for menu_item in meta_menus %}
        {% assign raw_cutoff = menu_item.cutoff_date_time.value | default: menu_item.cutoff_date_time | default: menu_item.cutoff_date %}
        {% assign raw_deliv = menu_item.delivery_date.value | default: menu_item.delivery_date | default: menu_item.date | default: menu_item.display_name | default: menu_item.title %}

        {% assign cutoff_ts = raw_cutoff | date: '%s' | plus: 0 %}
        {% comment %} Set delivery expiration to Monday 11:59:59 PM UK time (end of delivery day) {% endcomment %}
        {% assign deliv_ts = raw_deliv | date: '%s' | plus: 86399 %}

        {% comment %} Check if cutoff or delivery is upcoming in the future {% endcomment %}
        {% if cutoff_ts >= now_ts or deliv_ts >= now_ts %}
          {% assign diff = deliv_ts | minus: now_ts %}
          {% if diff < 0 %}
            {% assign diff = cutoff_ts | minus: now_ts %}
          {% endif %}

          {% if diff >= 0 and diff < min_future_diff %}
            {% assign min_future_diff = diff %}
            {% assign next_week_menu = menu_item %}
          {% endif %}
        {% else %}
          {% comment %} Track most recent past menu as fallback {% endcomment %}
          {% assign past_diff = now_ts | minus: deliv_ts %}
          {% if past_diff < min_past_diff %}
            {% assign min_past_diff = past_diff %}
            {% assign fallback_recent_menu = menu_item %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {% if next_week_menu == nil and fallback_recent_menu %}
        {% assign next_week_menu = fallback_recent_menu %}
      {% elsif next_week_menu == nil and meta_menus.size > 0 %}
        {% assign next_week_menu = meta_menus.first %}
      {% endif %}

      {% assign active_delivery_date = nil %}
      {% assign active_cutoff_date = nil %}
      {% assign active_meta_meals = nil %}
      {% assign is_cutoff_passed = false %}
      {% assign cutoff_ts = 0 %}
      {% if next_week_menu %}
        {% assign raw_deliv = next_week_menu.delivery_date.value | default: next_week_menu.delivery_date | default: next_week_menu.date | default: next_week_menu.display_name | default: next_week_menu.title %}
        {% assign active_delivery_date = raw_deliv | date: "%a %d %b" %}

        {% assign raw_cutoff = next_week_menu.cutoff_date_time.value | default: next_week_menu.cutoff_date_time | default: next_week_menu.cutoff_date %}
        {% assign active_cutoff_date = raw_cutoff | date: "%a %d %b @ 11:59 PM UK" %}

        {% assign cutoff_ts = raw_cutoff | date: '%s' | plus: 0 %}
        {% if cutoff_ts > 0 and now_ts > cutoff_ts %}
          {% assign is_cutoff_passed = true %}
        {% endif %}

        {% assign active_meta_meals = next_week_menu.meals.value | default: next_week_menu.meals | default: next_week_menu.products.value | default: next_week_menu.products | default: next_week_menu.dishes.value | default: next_week_menu.meal_items.value | default: next_week_menu.meal_items | default: next_week_menu.menu_items.value | default: next_week_menu.menu_items | default: next_week_menu.items.value | default: next_week_menu.items %}
        {% if active_meta_meals == blank or active_meta_meals.size == 0 %}
          {% if next_week_menu.fields %}
            {% for f in next_week_menu.fields %}
              {% assign f_key = f.key | downcase %}
              {% if f_key == 'meals' or f_key == 'products' or f_key == 'dishes' or f_key == 'items' or f_key == 'menu_items' or f_key == 'meal_items' %}
                {% if f.value != blank %}
                  {% assign active_meta_meals = f.value %}
                  {% break %}
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endif %}
        {% assign active_meta_addons = next_week_menu.add_on_products.value | default: next_week_menu.add_on_products | default: next_week_menu['add_on_products'].value | default: next_week_menu['add_on_products'] | default: next_week_menu.addon_meals.value | default: next_week_menu.addon_meals | default: next_week_menu['addon_meals'].value | default: next_week_menu['addon_meals'] | default: next_week_menu.add_on_meals.value | default: next_week_menu.add_on_meals | default: next_week_menu.addon_products.value | default: next_week_menu.addon_products | default: next_week_menu['addon_products'].value | default: next_week_menu['addon_products'] | default: next_week_menu.addons.value | default: next_week_menu.addons | default: next_week_menu.add_ons.value | default: next_week_menu.add_ons | default: next_week_menu.featured_addons.value | default: next_week_menu.featured_addons | default: next_week_menu.featured_add_ons.value | default: next_week_menu.featured_add_ons | default: next_week_menu.addon_items.value | default: next_week_menu.addon_items | default: next_week_menu.addon_product.value | default: next_week_menu.addon_product | default: next_week_menu.extra_products.value | default: next_week_menu.extra_products | default: next_week_menu.extras.value | default: next_week_menu.extras | default: next_week_menu.step_3_products.value | default: next_week_menu.step_3_products %}
        {% if active_meta_addons.value %}
          {% assign active_meta_addons = active_meta_addons.value %}
        {% endif %}
        {% if active_meta_addons == blank or active_meta_addons.size == 0 %}
          {% if next_week_menu.fields %}
            {% for f in next_week_menu.fields %}
              {% assign f_key = f.key | downcase %}
              {% if f_key contains 'addon' or f_key contains 'add_on' or f_key contains 'extra' %}
                {% if f.value != blank %}
                  {% assign active_meta_addons = f.value %}
                  {% if active_meta_addons.value %}
                    {% assign active_meta_addons = active_meta_addons.value %}
                  {% endif %}
                  {% break %}
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endif %}
      {% endif %}

      {% comment %} Hide Addon Option If Addon Meals Not Selected in Weekly Menu Metaobject {% endcomment %}
      {% assign has_meta_addons = false %}
      {% if active_meta_addons and active_meta_addons.size > 0 %}
        {% assign has_meta_addons = true %}
      {% elsif addons and addons.size > 0 and next_week_menu == nil %}
        {% comment %} Local express server mock testing only {% endcomment %}
        {% assign has_meta_addons = true %}
      {% endif %}

      {% comment %} 🛡️ Live vs Duplicate Theme Isolation (Shapes - Shubham 13.Oct) {% endcomment %}
      {% assign is_duplicate_theme = false %}
      {% if theme.role != 'main' %}
        {% assign is_duplicate_theme = true %}
      {% endif %}
      {% assign down_tname = theme.name | downcase %}
      {% if down_tname contains 'shubham' or down_tname contains '13.oct' or down_tname contains 'duplicate' or down_tname contains 'copy' or down_tname contains 'draft' %}
        {% assign is_duplicate_theme = true %}
      {% endif %}
      {% if content_for_header contains 'preview_theme_id' or canonical_url contains 'preview_theme_id' %}
        {% assign is_duplicate_theme = true %}
      {% endif %}
{% endraw %}
      {% if isDuplicateTheme %}
        {% assign is_duplicate_theme = true %}
      {% endif %}

<section class="gimmie-build-box">
  <div class="gimmie-build-box__section">
    <div class="gimmie-build-box__inner">

      <!-- Header -->
      <header class="gimmie-build-box__header">
        <p class="gimmie-build-box__eyebrow">
          Active Subscription • {% raw %}{{ customer.name | default: customer.first_name | default: 'Subscriber' }}{% endraw %}
        </p>
        <h1 class="gimmie-build-box__heading">Choose Your Meals</h1>
        <p class="gimmie-build-box__intro">
          Select your <strong>{{ mealQuota }} meals</strong> for your upcoming delivery on <strong>{% raw %}{{ active_delivery_date | default: 'Upcoming Monday' }}{% endraw %}</strong>.
        </p>
      </header>

      <!-- Main Layout -->
      <div class="gimmie-build-box__layout">

        <!-- Left Column -->
        <div class="gimmie-build-box__main">

          <!-- Step 1: Active Order & Current Selection Status -->
          <div class="gimmie-build-box__panel">
            <div class="gimmie-build-box__surface">
              <div class="gimmie-build-box__panel-header">
                <span class="gimmie-build-box__step">1</span>
                <div class="gimmie-build-box__title-wrap">
                  <h2 class="gimmie-build-box__panel-title">Upcoming Delivery</h2>
                </div>
              </div>

              <div class="gimmie-build-box__details" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
                <div class="gimmie-build-box__detail">
                  <strong>Logged-In Account</strong>
                  <span id="gimmie-display-customer" style="color: var(--gimmie-text); font-weight: 700; word-break: break-word;">
                    👤 <span id="gimmie-cust-name">{% raw %}{{ customer.first_name | default: customer.name | default: 'Subscriber' }} {{ customer.last_name }}{% endraw %}</span>
                    <span id="gimmie-cust-email" style="font-size: 0.85em; color: var(--gimmie-muted);">{% raw %}({{ customer.email }}){% endraw %}</span>
                  </span>
                </div>
                <div class="gimmie-build-box__detail">
                  <strong>Delivery Date</strong>
                  <span style="color: var(--gimmie-text);">📅 {% raw %}{{ active_delivery_date | default: 'Upcoming Monday' }}{% endraw %}</span>
                </div>
                <div class="gimmie-build-box__detail">
                  <strong>Your Box Size</strong>
                  <span>🍽️ {{ mealQuota }} Meals / Week</span>
                </div>
                <div class="gimmie-build-box__detail">
                  <strong>Cut-Off Time</strong>
                  <span>⏰ {% raw %}{{ active_cutoff_date | default: 'Thursday @ 11:59 PM UK' }}{% endraw %}
                    {% raw %}{% if is_cutoff_passed %}{% endraw %}
                      <span style="display:inline-block; font-size: 0.72rem; padding: 2px 6px; border-radius: 4px; background: #fee2e2; color: #991b1b; font-weight: 700; margin-left: 4px;">PASSED</span>
                    {% raw %}{% endif %}{% endraw %}
                  </span>
                </div>
              </div>

              <!-- Currently Saved Meal Selections Banner -->
              <div id="gimmie-saved-banner" style="margin-top: 16px; padding: 14px 18px; border: 2px solid var(--gimmie-success); border-radius: 16px; background: #e8f5e8;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                  <strong style="color: var(--gimmie-success); font-size: 0.92rem; text-transform: uppercase; letter-spacing: 0.04em;">
                    ✓ Your current meal selection
                  </strong>
                  <span style="font-size: 0.8rem; font-weight: 700; color: var(--gimmie-muted);">Editable until Thursday 11:59 PM</span>
                </div>
                <p id="gimmie-saved-summary-text" style="margin: 0; font-size: 0.95rem; font-weight: 700; color: var(--gimmie-text);">
                  Loading your saved selections...
                </p>
              </div>

            </div>
          </div>

          <!-- Step 2: Meal Selection Grid -->
          <div class="gimmie-build-box__panel">
            <div class="gimmie-build-box__surface">
              <div class="gimmie-build-box__panel-header gimmie-build-box__panel-header--meals" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 14px;">
                  <span class="gimmie-build-box__step">2</span>
                  <h2 class="gimmie-build-box__panel-title" style="margin: 0;">Pick your meals</h2>
                </div>
                <div id="gimmie-counter-badge" class="gimmie-build-box__counter" style="font-size: 0.9rem; font-weight: 700; color: var(--gimmie-muted);">
                  <span id="gimmie-step2-count">0</span> of <span id="gimmie-step2-quota">{{ mealQuota }}</span> Selected
                </div>
              </div>

              <!-- Meals Grid - Responsive 2 in row desktop, 1 in row mobile -->
              <div class="gimmie-build-box__meals-grid">
                {% raw %}
                  {% if active_meta_meals and active_meta_meals.size > 0 %}
                    {% for meal_raw in active_meta_meals %}
                      {% assign current_meal = meal_raw.value | default: meal_raw %}
                      {% assign meal_obj = current_meal.product.value | default: current_meal.product | default: current_meal %}
                      {% assign m_title = meal_obj.title.value | default: meal_obj.title | default: current_meal.title.value | default: current_meal.title | default: current_meal.name.value | default: current_meal.name %}
                      
                      {% assign m_img = nil %}
                      {% if current_meal.meal_image.value %}
                        {% assign m_img = current_meal.meal_image.value | image_url: width: 800 %}
                      {% elsif current_meal.meal_image %}
                        {% assign m_img = current_meal.meal_image | image_url: width: 800 %}
                      {% elsif meal_obj.meal_image.value %}
                        {% assign m_img = meal_obj.meal_image.value | image_url: width: 800 %}
                      {% elsif meal_obj.meal_image %}
                        {% assign m_img = meal_obj.meal_image | image_url: width: 800 %}
                      {% elsif meal_obj.featured_image.value %}
                        {% assign m_img = meal_obj.featured_image.value | image_url: width: 800 %}
                      {% elsif meal_obj.featured_image %}
                        {% assign m_img = meal_obj.featured_image | image_url: width: 800 %}
                      {% elsif meal_obj.featured_media.value %}
                        {% assign m_img = meal_obj.featured_media.value | image_url: width: 800 %}
                      {% elsif meal_obj.featured_media %}
                        {% assign m_img = meal_obj.featured_media | image_url: width: 800 %}
                      {% elsif meal_obj.image.value %}
                        {% assign m_img = meal_obj.image.value | image_url: width: 800 %}
                      {% elsif meal_obj.image %}
                        {% assign m_img = meal_obj.image | image_url: width: 800 %}
                      {% elsif current_meal.image.value %}
                        {% assign m_img = current_meal.image.value | image_url: width: 800 %}
                      {% elsif current_meal.image %}
                        {% assign m_img = current_meal.image | image_url: width: 800 %}
                      {% elsif current_meal.photo.value %}
                        {% assign m_img = current_meal.photo.value | image_url: width: 800 %}
                      {% elsif current_meal.photo %}
                        {% assign m_img = current_meal.photo | image_url: width: 800 %}
                      {% elsif meal_obj.photo.value %}
                        {% assign m_img = meal_obj.photo.value | image_url: width: 800 %}
                      {% elsif meal_obj.photo %}
                        {% assign m_img = meal_obj.photo | image_url: width: 800 %}
                      {% elsif meal_obj.picture.value %}
                        {% assign m_img = meal_obj.picture.value | image_url: width: 800 %}
                      {% elsif meal_obj.picture %}
                        {% assign m_img = meal_obj.picture | image_url: width: 800 %}
                      {% elsif meal_obj.thumbnail.value %}
                        {% assign m_img = meal_obj.thumbnail.value | image_url: width: 800 %}
                      {% elsif meal_obj.thumbnail %}
                        {% assign m_img = meal_obj.thumbnail | image_url: width: 800 %}
                      {% endif %}

                      {% if m_img == blank or m_img == '' %}
                        {% assign down_t = m_title | downcase %}
                        {% if down_t contains 'salmon' or down_t contains 'penne' or down_t contains 'pesto' or down_t contains 'fish' %}
                          {% assign m_img = 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80' %}
                        {% elsif down_t contains 'beef' or down_t contains 'hoisin' or down_t contains 'bolognese' or down_t contains 'steak' %}
                          {% assign m_img = 'https://images.unsplash.com/photo-1551183053-bf91a1d81141?auto=format&fit=crop&w=800&q=80' %}
                        {% elsif down_t contains 'chicken' or down_t contains 'burrito' or down_t contains 'tuscan' %}
                          {% assign m_img = 'https://images.unsplash.com/photo-1547496502-affa22d38842?auto=format&fit=crop&w=800&q=80' %}
                        {% elsif down_t contains 'curry' or down_t contains 'plant' or down_t contains 'vegan' or down_t contains 'potato' %}
                          {% assign m_img = 'https://images.unsplash.com/photo-1585937421612-70a008356fbe?auto=format&fit=crop&w=800&q=80' %}
                        {% else %}
                          {% assign m_img = 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80' %}
                        {% endif %}
                      {% endif %}

                      {% assign meal_handle = meal_raw.system.handle | default: meal_raw.handle | default: meal_obj.system.handle | default: meal_obj.handle %}
                      {% if meal_handle == blank or meal_handle == '' %}
                        {% assign meal_handle = m_title | handleize %}
                      {% endif %}

                      {% assign direct_meal = shop.metaobjects.meal[meal_handle] %}
                      {% if direct_meal == blank or direct_meal.protein == blank %}
                        {% assign mh1 = m_title | handleize %}
                        {% assign mh2 = m_title | replace: '&', 'and' | handleize %}
                        {% assign mh3 = m_title | replace: '&', '' | handleize %}
                        {% assign mh4 = m_title | replace: ' & ', ' and ' | handleize %}
                        {% assign mh5 = m_title | replace: ' & ', '-' | handleize %}
                        {% assign handle_alt = m_title | downcase | replace: ' ', '-' | replace: '&', 'and' | replace: "'", "" %}
                        {% assign handle_alt2 = m_title | downcase | replace: ' ', '-' | replace: '&', '' | replace: "'", "" %}
                        {% assign direct_meal = shop.metaobjects.meal[mh1] | default: shop.metaobjects.meal[mh2] | default: shop.metaobjects.meal[mh3] | default: shop.metaobjects.meal[mh4] | default: shop.metaobjects.meal[mh5] | default: shop.metaobjects.meal[handle_alt] | default: shop.metaobjects.meal[handle_alt2] %}
                      {% endif %}
                      {% if direct_meal == blank or direct_meal.protein == blank %}
                        {% assign down_check = m_title | downcase %}
                        {% if down_check contains 'thai' and down_check contains 'curry' %}
                          {% assign direct_meal = shop.metaobjects.meal['thai-red-chicken-curry'] %}
                        {% elsif down_check contains 'sausage' or down_check contains 'ragu' or down_check contains 'rigatoni' %}
                          {% assign direct_meal = shop.metaobjects.meal['sausage-ragu-rigatoni'] | default: shop.metaobjects.meal['sausage-ragu'] %}
                        {% elsif down_check contains 'tarragon' %}
                          {% assign direct_meal = shop.metaobjects.meal['tarragon-chicken'] %}
                        {% elsif down_check contains 'hoisin' %}
                          {% assign direct_meal = shop.metaobjects.meal['hoisin-beef-bowl'] | default: shop.metaobjects.meal['hoisin-beef'] %}
                        {% elsif down_check contains 'gnocchi' or down_check contains 'bolognese' %}
                          {% assign direct_meal = shop.metaobjects.meal['bolognese-gnocchi'] %}
                        {% elsif down_check contains 'fajita' %}
