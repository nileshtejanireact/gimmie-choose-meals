        totalAddonsPrice += q * (parseFloat(item.price) || 0);
        totalAddonsOriginalPrice += q * (parseFloat(item.originalPrice || item.price) || 0);
      });
      state.totalAddons = totalAddonsCount;
      state.totalAddonsPrice = totalAddonsPrice;
      state.totalAddonsOriginalPrice = totalAddonsOriginalPrice;

