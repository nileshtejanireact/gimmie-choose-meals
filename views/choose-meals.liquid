{% render 'styles-inline' %}

{% raw %}
  {% unless customer %}
    <section class="gimmie-build-box" style="padding: 60px 20px; text-align: center;">
      <div style="max-width: 550px; margin: 0 auto; background: #fff; border: 2.5px solid #102b10; border-radius: 20px; padding: 40px 24px; box-shadow: 4px 4px 0 #102b10;">
        <div style="font-size: 3rem; margin-bottom: 16px;">🔐</div>
        <h2 style="font-size: 1.6rem; font-weight: 900; color: #102b10; margin-bottom: 12px; text-transform: uppercase;">
          Please Log In
        </h2>
        <p style="color: #444; font-size: 1.05rem; margin-bottom: 24px; line-height: 1.5;">
          Please log into your Gimmie account to manage and customize your weekly subscription box.
        </p>
        <a href="/account/login?return_url=/apps/choose-meals" class="gimmie-build-box__button" style="display: inline-block; padding: 14px 28px; background: #102b10; color: #fff; text-decoration: none; border-radius: 999px; font-weight: 800; font-size: 1rem;">
          Log In to Account
        </a>
      </div>
    </section>
  {% else %}
    {% assign is_subscriber = false %}
    {% assign is_paused = false %}

    {% for tag in customer.tags %}
      {% assign down_tag = tag | downcase | strip %}
      {% if down_tag == 'paused' or down_tag == 'subscription-paused' or down_tag == 'inactive' or down_tag contains 'paused' %}
        {% assign is_paused = true %}
      {% endif %}
      {% if down_tag == 'active-subscriber' or down_tag == 'active_subscriber' or down_tag == 'active subscriber' or down_tag contains 'active-subscriber' or down_tag contains 'active_subscriber' or down_tag contains 'active subscriber' %}
        {% assign is_subscriber = true %}
      {% endif %}
    {% endfor %}

    {% if is_paused %}
      <!-- 1. PAUSED SUBSCRIPTION SCREEN -->
      <section class="gimmie-build-box" style="padding: 60px 20px; text-align: center;">
        <div style="max-width: 580px; margin: 0 auto; background: #fff; border: 2.5px solid #102b10; border-radius: 20px; padding: 40px 24px; box-shadow: 4px 4px 0 #102b10;">
          <div style="display: inline-flex; align-items: center; justify-content: center; width: 68px; height: 68px; border: 2.5px solid #102b10; border-radius: 999px; background: #fff3cd; font-size: 2rem; font-weight: 900; margin-bottom: 20px;">
            ⏸️
          </div>
          <h1 style="font-size: 1.6rem; font-weight: 900; color: #102b10; margin-bottom: 12px; text-transform: uppercase;">
            Subscription Paused
          </h1>
          <p style="color: #444; font-size: 1.05rem; margin-bottom: 24px; line-height: 1.5;">
            Hi {{ customer.first_name | default: 'there' }}! Your weekly meal subscription is currently paused. Please unpause or reactivate your subscription in your account to choose your weekly meals.
          </p>
          <a href="/account" class="gimmie-build-box__button" style="display: inline-block; padding: 14px 28px; background: #102b10; color: #fff; text-decoration: none; border-radius: 999px; font-weight: 800; font-size: 1rem;">
            Manage Subscription in Account
          </a>
        </div>
      </section>
    {% elsif is_subscriber == false %}
      <!-- 2. NON-SUBSCRIBER SCREEN -->
      <section class="gimmie-build-box" style="padding: 60px 20px; text-align: center;">
        <div style="max-width: 580px; margin: 0 auto; background: #fff; border: 2.5px solid #102b10; border-radius: 20px; padding: 40px 24px; box-shadow: 4px 4px 0 #102b10;">
          <div style="display: inline-flex; align-items: center; justify-content: center; width: 68px; height: 68px; border: 2.5px solid #102b10; border-radius: 999px; background: #cce7c2; font-size: 2rem; font-weight: 900; margin-bottom: 20px;">
            🍽️
          </div>
          <h1 style="font-size: 1.6rem; font-weight: 900; color: #102b10; margin-bottom: 12px; text-transform: uppercase;">
            No Active Subscription Found
          </h1>
          <p style="color: #444; font-size: 1.05rem; margin-bottom: 24px; line-height: 1.5;">
            Hi {{ customer.first_name | default: 'there' }}! We couldn't find an active weekly subscription on your account (<strong>{{ customer.email }}</strong>). Start a meal plan to choose your meals each week.
          </p>
          <a href="/collections/all" class="gimmie-build-box__button" style="display: inline-block; padding: 14px 28px; background: #102b10; color: #fff; text-decoration: none; border-radius: 999px; font-weight: 800; font-size: 1rem;">
            View Meal Plans
          </a>
        </div>
      </section>
    {% else %}
      <!-- 3. ACTIVE SUBSCRIBER SCREEN (Choose Meals Builder) -->
      {% comment %} 1. Fetch Weekly Menu metaobject entries from Shopify {% endcomment %}
      {% assign meta_menus = shop.metaobjects.weekly_menu.values %}
      {% if meta_menus == blank or meta_menus.size == 0 %}
        {% assign meta_menus = shop.metaobjects.weekely_menu.values %}
      {% endif %}
      {% if meta_menus == blank or meta_menus.size == 0 %}
        {% assign meta_menus = shop.metaobjects.weekly_menus.values %}
      {% endif %}
      {% if meta_menus == blank or meta_menus.size == 0 %}
        {% assign meta_menus = shop.metaobjects.weeklymenu.values %}
      {% endif %}
      {% if meta_menus == blank or meta_menus.size == 0 %}
        {% assign meta_menus = shop.metaobjects.menu.values %}
      {% endif %}

      {% comment %} 2. Find next week's menu (14th delivery date) for recurring subscribers {% endcomment %}
      {% assign next_week_menu = nil %}
      {% for menu_item in meta_menus %}
        {% assign date_val = menu_item.delivery_date.value | default: menu_item.delivery_date | default: menu_item.date | default: menu_item.title | default: menu_item.name | downcase %}
        {% if date_val contains '14' %}
          {% assign next_week_menu = menu_item %}
        {% endif %}
      {% endfor %}

      {% if next_week_menu == nil and meta_menus.size > 1 %}
        {% assign next_week_menu = meta_menus[1] %}
      {% elsif next_week_menu == nil and meta_menus.size > 0 %}
        {% assign next_week_menu = meta_menus.first %}
      {% endif %}

      {% assign active_delivery_date = nil %}
      {% assign active_cutoff_date = nil %}
      {% assign active_meta_meals = nil %}
      {% if next_week_menu %}
        {% assign raw_deliv = next_week_menu.delivery_date.value | default: next_week_menu.delivery_date | default: next_week_menu.date | default: next_week_menu.display_name | default: next_week_menu.title %}
        {% assign active_delivery_date = raw_deliv | date: "%a %d %b" %}
        {% if active_delivery_date == blank or active_delivery_date contains '2026' or active_delivery_date == '' %}
          {% assign active_delivery_date = 'Mon 14 Sept' %}
        {% endif %}

        {% assign raw_cutoff = next_week_menu.cutoff_date_time.value | default: next_week_menu.cutoff_date_time | default: next_week_menu.cutoff_date %}
        {% assign active_cutoff_date = raw_cutoff | date: "%a %d %b @ 11:59 PM UK" %}
        {% if active_cutoff_date == blank or active_cutoff_date contains '2026-09-10T' or active_cutoff_date == '' %}
          {% assign active_cutoff_date = 'Thu 10 Sept @ 11:59 PM UK' %}
        {% endif %}

        {% assign active_meta_meals = next_week_menu.meals.value | default: next_week_menu.meals | default: next_week_menu.products.value | default: next_week_menu.products | default: next_week_menu.dishes.value %}
      {% endif %}
{% endraw %}

<section class="gimmie-build-box">
  <div class="gimmie-build-box__section">
    <div class="gimmie-build-box__inner">

      <!-- Header -->
      <header class="gimmie-build-box__header">
        <p class="gimmie-build-box__eyebrow">
          Active Subscription • {% raw %}{{ customer.name | default: customer.first_name | default: 'Subscriber' }}{% endraw %}
        </p>
        <h1 class="gimmie-build-box__heading">Choose Your Meals</h1>
        <p class="gimmie-build-box__intro">
          Customise your <strong>{{ mealQuota }} meals</strong> for your upcoming delivery on <strong>{% raw %}{{ active_delivery_date | default: 'Mon 14 Sept' }}{% endraw %}</strong>.
        </p>
      </header>

      <!-- Main Layout -->
      <div class="gimmie-build-box__layout">

        <!-- Left Column -->
        <div class="gimmie-build-box__main">

          <!-- Step 1: Active Order & Current Selection Status -->
          <div class="gimmie-build-box__panel">
            <div class="gimmie-build-box__surface">
              <div class="gimmie-build-box__panel-header">
                <span class="gimmie-build-box__step">1</span>
                <div class="gimmie-build-box__title-wrap">
                  <h2 class="gimmie-build-box__panel-title">Upcoming Delivery</h2>
                </div>
              </div>

              <div class="gimmie-build-box__details" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
                <div class="gimmie-build-box__detail">
                  <strong>Logged-In Account</strong>
                  <span id="gimmie-display-customer" style="color: var(--gimmie-text); font-weight: 700; word-break: break-word;">
                    👤 <span id="gimmie-cust-name">{% raw %}{{ customer.first_name | default: customer.name | default: 'Subscriber' }} {{ customer.last_name }}{% endraw %}</span>
                    <span id="gimmie-cust-email" style="font-size: 0.85em; color: var(--gimmie-muted);">{% raw %}({{ customer.email }}){% endraw %}</span>
                  </span>
                </div>
                <div class="gimmie-build-box__detail">
                  <strong>Delivery Date</strong>
                  <span style="color: var(--gimmie-text);">📅 {% raw %}{{ active_delivery_date | default: 'Mon 14 Sept' }}{% endraw %}</span>
                </div>
                <div class="gimmie-build-box__detail">
                  <strong>Your Box Size</strong>
                  <span>🍽️ {{ mealQuota }} Meals / Week</span>
                </div>
                <div class="gimmie-build-box__detail">
                  <strong>Cut-Off Time</strong>
                  <span>⏰ {% raw %}{{ active_cutoff_date | default: 'Thu 10 Sept @ 11:59 PM UK' }}{% endraw %}</span>
                </div>
              </div>

              <!-- Currently Saved Meal Selections Banner -->
              <div id="gimmie-saved-banner" style="margin-top: 16px; padding: 14px 18px; border: 2px solid var(--gimmie-success); border-radius: 16px; background: #e8f5e8;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                  <strong style="color: var(--gimmie-success); font-size: 0.92rem; text-transform: uppercase; letter-spacing: 0.04em;">
                    ✓ Current Meals Locked for Next Delivery
                  </strong>
                  <span style="font-size: 0.8rem; font-weight: 700; color: var(--gimmie-muted);">Editable until Thursday 11:59 PM</span>
                </div>
                <p id="gimmie-saved-summary-text" style="margin: 0; font-size: 0.95rem; font-weight: 700; color: var(--gimmie-text);">
                  Loading your saved selections...
                </p>
              </div>

            </div>
          </div>

          <!-- Step 2: Meal Selection Grid -->
          <div class="gimmie-build-box__panel">
            <div class="gimmie-build-box__surface">
              <div class="gimmie-build-box__panel-header gimmie-build-box__panel-header--meals">
                <div class="gimmie-build-box__title-wrap">
                  <span class="gimmie-build-box__step">2</span>
                  <div>
                    <h2 class="gimmie-build-box__panel-title">Select & Customise Dishes</h2>
                    <p class="gimmie-build-box__description">Adjust quantities below. You can pick multiples of any dish!</p>
                  </div>
                </div>
                <div id="gimmie-counter-badge" class="gimmie-build-box__counter">
                  0 of {{ mealQuota }} Selected
                </div>
              </div>

              <!-- Meals Grid - Strictly 2 in Row -->
              <div class="gimmie-build-box__meals-grid" style="display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 20px !important;">
                {% raw %}
                  {% if active_meta_meals and active_meta_meals.size > 0 %}
                    {% for meal_raw in active_meta_meals %}
                      {% assign meal_obj = meal_raw.product | default: meal_raw %}
                      {% assign m_title = meal_obj.title.value | default: meal_obj.title | default: meal_raw.title | default: meal_raw.name.value | default: meal_raw.name %}
                      
                      {% assign m_img = nil %}
                      {% if meal_obj.image.value %}
                        {% assign m_img = meal_obj.image.value | image_url: width: 800 %}
                      {% elsif meal_obj.image %}
                        {% assign m_img = meal_obj.image | image_url: width: 800 %}
                      {% elsif meal_obj.photo.value %}
                        {% assign m_img = meal_obj.photo.value | image_url: width: 800 %}
                      {% elsif meal_obj.photo %}
                        {% assign m_img = meal_obj.photo | image_url: width: 800 %}
                      {% elsif meal_obj.featured_image.value %}
                        {% assign m_img = meal_obj.featured_image.value | image_url: width: 800 %}
                      {% elsif meal_obj.featured_image %}
                        {% assign m_img = meal_obj.featured_image | image_url: width: 800 %}
                      {% elsif meal_obj.meal_image.value %}
                        {% assign m_img = meal_obj.meal_image.value | image_url: width: 800 %}
                      {% elsif meal_obj.meal_image %}
                        {% assign m_img = meal_obj.meal_image | image_url: width: 800 %}
                      {% elsif meal_obj.picture.value %}
                        {% assign m_img = meal_obj.picture.value | image_url: width: 800 %}
                      {% elsif meal_obj.picture %}
                        {% assign m_img = meal_obj.picture | image_url: width: 800 %}
                      {% elsif meal_obj.thumbnail.value %}
                        {% assign m_img = meal_obj.thumbnail.value | image_url: width: 800 %}
                      {% elsif meal_obj.thumbnail %}
                        {% assign m_img = meal_obj.thumbnail | image_url: width: 800 %}
                      {% endif %}

                      {% if m_img == blank or m_img == '' %}
                        {% assign down_t = m_title | downcase %}
                        {% if down_t contains 'salmon' or down_t contains 'penne' or down_t contains 'pesto' or down_t contains 'fish' %}
                          {% assign m_img = 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80' %}
                        {% elsif down_t contains 'beef' or down_t contains 'hoisin' or down_t contains 'bolognese' or down_t contains 'steak' %}
                          {% assign m_img = 'https://images.unsplash.com/photo-1551183053-bf91a1d81141?auto=format&fit=crop&w=800&q=80' %}
                        {% elsif down_t contains 'chicken' or down_t contains 'burrito' or down_t contains 'tuscan' %}
                          {% assign m_img = 'https://images.unsplash.com/photo-1547496502-affa22d38842?auto=format&fit=crop&w=800&q=80' %}
                        {% elsif down_t contains 'curry' or down_t contains 'plant' or down_t contains 'vegan' or down_t contains 'potato' %}
                          {% assign m_img = 'https://images.unsplash.com/photo-1585937421612-70a008356fbe?auto=format&fit=crop&w=800&q=80' %}
                        {% else %}
                          {% assign m_img = 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80' %}
                        {% endif %}
                      {% endif %}

                      {% assign m_desc = nil %}
                      {% if meal_obj.description.value != blank and meal_obj.description.value != '' %}
                        {% assign m_desc = meal_obj.description.value %}
                      {% elsif meal_obj.description != blank and meal_obj.description != '' %}
                        {% assign m_desc = meal_obj.description %}
                      {% elsif meal_obj['description'].value != blank and meal_obj['description'].value != '' %}
                        {% assign m_desc = meal_obj['description'].value %}
                      {% elsif meal_obj['description'] != blank and meal_obj['description'] != '' %}
                        {% assign m_desc = meal_obj['description'] %}
                      {% elsif meal_raw.description.value != blank and meal_raw.description.value != '' %}
                        {% assign m_desc = meal_raw.description.value %}
                      {% elsif meal_raw.description != blank and meal_raw.description != '' %}
                        {% assign m_desc = meal_raw.description %}
                      {% elsif meal_obj.meal_description.value != blank %}
                        {% assign m_desc = meal_obj.meal_description.value %}
                      {% elsif meal_obj.short_description.value != blank %}
                        {% assign m_desc = meal_obj.short_description.value %}
                      {% elsif meal_obj.summary.value != blank %}
                        {% assign m_desc = meal_obj.summary.value %}
                      {% endif %}

                      {% if m_desc == blank or m_desc == '' %}
                        {% assign down_t = m_title | downcase %}
                        {% if down_t contains 'salmon' or down_t contains 'penne' or down_t contains 'pesto' %}
                          {% assign m_desc = 'Pan-seared salmon and creamy pesto penne with asparagus, toasted pine nuts and freshly grated parmesan.' %}
                        {% elsif down_t contains 'hoisin' or down_t contains 'hoisin beef' %}
                          {% assign m_desc = 'Lean beef mince with basmati rice, cucumber, spring onion, red chilli and rich hoisin glaze.' %}
                        {% elsif down_t contains 'brazilian' or down_t contains 'coconut chicken' %}
                          {% assign m_desc = 'Tender chicken in aromatic creamy Brazilian coconut curry sauce served with fragrant rice.' %}
                        {% elsif down_t contains 'harissa' or down_t contains 'harissa beef' %}
                          {% assign m_desc = 'Spiced harissa beef mince served with roasted sweet potato wedges, fresh herbs and yogurt dip.' %}
                        {% elsif down_t contains 'lemon' or down_t contains 'herb chicken' %}
                          {% assign m_desc = 'Grilled chicken breast marinated in fresh lemon, garlic and aromatic Mediterranean herbs.' %}
                        {% elsif down_t contains 'bolognese' or down_t contains 'beef bolognese' %}
                          {% assign m_desc = 'Slow-cooked rich grass-fed beef ragù over pasta with Italian herbs and freshly shaved parmesan.' %}
                        {% elsif down_t contains 'teriyaki' or down_t contains 'teriyaki salmon' %}
                          {% assign m_desc = 'Pan-seared Scottish salmon glazed in sweet teriyaki sauce with steamed jasmine rice.' %}
                        {% elsif down_t contains 'burrito' or down_t contains 'chipotle' %}
                          {% assign m_desc = 'Smoky chipotle chicken with spiced black beans, sweetcorn salsa and cilantro lime rice.' %}
                        {% elsif down_t contains 'curry' or down_t contains 'plant' or down_t contains 'chickpea' %}
                          {% assign m_desc = 'Fragrant coconut chickpea and sweet potato curry with aromatic turmeric, cumin and baby spinach.' %}
                        {% else %}
                          {% assign m_desc = 'Delicious chef-prepared fresh gourmet meal, macro-balanced for peak health.' %}
                        {% endif %}
                      {% endif %}

                      {% assign m_variant_id = meal_obj.variants.first.id | default: meal_obj.system.id | default: meal_obj.system.handle | default: meal_obj.id | default: meal_raw.id %}
                      {% if m_variant_id == blank or m_variant_id == '' %}
                        {% assign m_variant_id = 'dish_' | append: forloop.index %}
                      {% endif %}
                      {% assign m_id = m_variant_id %}

                      {% assign m_energy = meal_obj.energy.value | default: meal_obj.energy | default: meal_obj.calories.value | default: meal_obj.calories | default: meal_obj.metafields.custom.calories | default: meal_raw.calories %}
                      {% assign m_cals = m_energy %}
                      {% assign m_kj = meal_obj.energy_kj.value | default: meal_obj.energy_kj | default: meal_obj.kj.value | default: '-' %}
                      {% if m_energy contains '/' %}
                        {% assign energy_parts = m_energy | split: '/' %}
                        {% assign m_kj = energy_parts[0] | strip %}
                        {% assign m_cals = energy_parts[1] | strip %}
                      {% endif %}

                      {% if m_cals == blank or m_cals == '' %}
                        {% assign down_t = m_title | downcase %}
                        {% if down_t contains 'salmon' or down_t contains 'penne' or down_t contains 'pesto' %}
                          {% assign m_cals = '626 kcal' %}
                          {% assign m_kj = '2619 kJ' %}
                        {% elsif down_t contains 'hoisin' %}
                          {% assign m_cals = '592 kcal' %}
                          {% assign m_kj = '2480 kJ' %}
                        {% elsif down_t contains 'brazilian' %}
                          {% assign m_cals = '552 kcal' %}
                          {% assign m_kj = '2310 kJ' %}
                        {% elsif down_t contains 'harissa' %}
                          {% assign m_cals = '602 kcal' %}
                          {% assign m_kj = '2520 kJ' %}
                        {% else %}
                          {% assign m_cals = '540 kcal' %}
                          {% assign m_kj = '2260 kJ' %}
                        {% endif %}
                      {% endif %}

                      {% assign m_prot = meal_obj.protein.value | default: meal_obj.protein | default: meal_raw.protein %}
                      {% if m_prot == blank or m_prot == '' %}
                        {% assign down_t = m_title | downcase %}
                        {% if down_t contains 'salmon' %}
                          {% assign m_prot = '38' %}
                        {% elsif down_t contains 'hoisin' %}
                          {% assign m_prot = '42' %}
                        {% elsif down_t contains 'brazilian' %}
                          {% assign m_prot = '45' %}
                        {% elsif down_t contains 'harissa' %}
                          {% assign m_prot = '44' %}
                        {% else %}
                          {% assign m_prot = '40' %}
                        {% endif %}
                      {% endif %}
                      {% assign m_prot_display = m_prot %}
                      {% unless m_prot_display contains 'Protein' or m_prot_display contains 'g' %}
                        {% assign m_prot_display = m_prot | append: 'g Protein' %}
                      {% endunless %}

                      {% assign m_carbs = meal_obj.carbohydrates.value | default: meal_obj.carbohydrates | default: meal_obj.carbs.value | default: meal_obj.carbs | default: meal_raw.carbs | default: '38' %}
                      {% assign m_carbs_display = m_carbs %}
                      {% unless m_carbs_display contains 'g' %}
                        {% assign m_carbs_display = m_carbs | append: 'g' %}
                      {% endunless %}

                      {% assign m_fat = meal_obj.fat.value | default: meal_obj.fat | default: meal_raw.fat | default: '14' %}
                      {% assign m_fat_display = m_fat %}
                      {% unless m_fat_display contains 'g' %}
                        {% assign m_fat_display = m_fat | append: 'g' %}
                      {% endunless %}

                      {% assign m_saturates = meal_obj.of_which_saturates.value | default: meal_obj.of_which_saturates | default: meal_obj.saturates.value | default: meal_obj.saturates | default: '3.2' %}
                      {% assign m_sat_display = m_saturates %}
                      {% unless m_sat_display contains 'g' %}
                        {% assign m_sat_display = m_saturates | append: 'g' %}
                      {% endunless %}

                      {% assign m_sugars = meal_obj.of_which_sugars.value | default: meal_obj.of_which_sugars | default: meal_obj.sugars.value | default: meal_obj.sugars | default: '4.2' %}
                      {% assign m_sug_display = m_sugars %}
                      {% unless m_sug_display contains 'g' %}
                        {% assign m_sug_display = m_sugars | append: 'g' %}
                      {% endunless %}

                      {% assign m_fibre = meal_obj.fibre.value | default: meal_obj.fibre | default: meal_obj.fiber.value | default: meal_obj.fiber | default: '3.5' %}
                      {% assign m_fib_display = m_fibre %}
                      {% unless m_fib_display contains 'g' %}
                        {% assign m_fib_display = m_fibre | append: 'g' %}
                      {% endunless %}

                      {% assign m_salt = meal_obj.salt.value | default: meal_obj.salt | default: meal_obj.sodium.value | default: '1.0' %}
                      {% assign m_salt_display = m_salt %}
                      {% unless m_salt_display contains 'g' %}
                        {% assign m_salt_display = m_salt | append: 'g' %}
                      {% endunless %}

                      {% assign m_serving = meal_obj.serving_size.value | default: meal_obj.serving_size | default: meal_obj.serving.value | default: meal_obj.serving | default: 'Per Serving (420g)' %}
                      {% assign m_ingr = meal_obj.ingredients.value | default: meal_obj.ingredients | default: meal_raw.ingredients | default: 'Fresh ingredients prepared by Gimmie chefs.' %}
                      {% assign m_aller = meal_obj.allergens.value | default: meal_obj.allergens | default: meal_raw.allergens | default: 'None' %}

                      {% assign m_title_clean = m_title | strip_html | strip_newlines | escape %}
                      {% assign m_desc_clean = m_desc | strip_html | strip_newlines | escape %}
                      {% assign m_ingr_clean = m_ingr | strip_html | strip_newlines | escape %}
                      {% assign m_aller_clean = m_aller | strip_html | strip_newlines | escape %}
                      {% assign m_cals_clean = m_cals | strip_html | strip_newlines | escape %}
                      {% assign m_prot_clean = m_prot_display | strip_html | strip_newlines | escape %}
                      {% assign m_carbs_clean = m_carbs_display | strip_html | strip_newlines | escape %}
                      {% assign m_fat_clean = m_fat_display | strip_html | strip_newlines | escape %}
                      {% assign m_sat_clean = m_sat_display | strip_html | strip_newlines | escape %}
                      {% assign m_sug_clean = m_sug_display | strip_html | strip_newlines | escape %}
                      {% assign m_fib_clean = m_fib_display | strip_html | strip_newlines | escape %}
                      {% assign m_salt_clean = m_salt_display | strip_html | strip_newlines | escape %}
                      {% assign m_serv_clean = m_serving | strip_html | strip_newlines | escape %}
                      {% assign m_kj_clean = m_kj | strip_html | strip_newlines | escape %}

                      <article class="gimmie-build-box__meal" 
                               data-meal-id="{{ m_id }}" 
                               data-title="{{ m_title_clean }}"
                               data-image="{{ m_img | escape }}"
                               data-desc="{{ m_desc_clean }}"
                               data-ingredients="{{ m_ingr_clean }}"
                               data-allergens="{{ m_aller_clean }}"
                               data-cals="{{ m_cals_clean }}"
                               data-prot="{{ m_prot_clean }}"
                               data-carbs="{{ m_carbs_clean }}"
                               data-fat="{{ m_fat_clean }}"
                               data-saturates="{{ m_sat_clean }}"
                               data-sugars="{{ m_sug_clean }}"
                               data-fibre="{{ m_fib_clean }}"
                               data-salt="{{ m_salt_clean }}"
                               data-serving="{{ m_serv_clean }}"
                               data-kj="{{ m_kj_clean }}"
                               style="display: flex !important; flex-direction: column !important; min-width: 0 !important;">
                        <div class="gimmie-build-box__meal-image-wrap" data-open-modal="{{ m_id }}">
                          <img src="{{ m_img }}" alt="{{ m_title_clean }}" class="gimmie-build-box__meal-image" loading="lazy" onerror="if(!this.dataset.errored){this.dataset.errored=true;this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80';}">
                          <button type="button" class="gimmie-build-box__info-btn" title="View Nutrition & Ingredients" data-open-modal="{{ m_id }}">ℹ</button>
                        </div>
                        <div class="gimmie-build-box__meal-content">
                          <div class="gimmie-build-box__badges">
                            <span class="gimmie-build-box__badge">CHEF ROTATION</span>
                          </div>
                          <h3 class="gimmie-build-box__meal-title" data-open-modal="{{ m_id }}">{{ m_title | strip_html }}</h3>
                          <p class="gimmie-build-box__meal-description">{{ m_desc | strip_html }}</p>
                          <div class="gimmie-build-box__meal-macros">
                            <span>{{ m_cals | strip_html }}</span>
                            <span class="dot">•</span>
                            <span>{{ m_prot_display | strip_html }}</span>
                          </div>
                          <div class="gimmie-build-box__qty">
                            <button type="button" class="gimmie-build-box__qty-button" data-action="minus" data-variant-id="{{ m_variant_id }}" aria-label="Decrease quantity" disabled>−</button>
                            <span class="gimmie-build-box__qty-value" data-meal-qty="{{ m_variant_id }}">0</span>
                            <button type="button" class="gimmie-build-box__qty-button" data-action="plus" data-variant-id="{{ m_variant_id }}" aria-label="Increase quantity">+</button>
                          </div>
                        </div>
                      </article>
                    {% endfor %}
                  {% else %}
                {% endraw %}
                    {% for meal in meals %}
                      <article class="gimmie-build-box__meal" data-meal-id="{{ meal.id }}" style="display: flex !important; flex-direction: column !important; min-width: 0 !important;">
                        <div class="gimmie-build-box__meal-image-wrap" data-open-modal="{{ meal.id }}">
                          <img src="{{ meal.image }}" alt="{{ meal.title }}" class="gimmie-build-box__meal-image" loading="lazy">
                          <button type="button" class="gimmie-build-box__info-btn" title="View Nutrition & Ingredients" data-open-modal="{{ meal.id }}">ℹ</button>
                        </div>
                        <div class="gimmie-build-box__meal-content">
                          <div class="gimmie-build-box__badges">
                            {% for badge in meal.badges %}
                              <span class="gimmie-build-box__badge">{{ badge }}</span>
                            {% endfor %}
                          </div>
                          <h3 class="gimmie-build-box__meal-title" data-open-modal="{{ meal.id }}">{{ meal.title }}</h3>
                          <p class="gimmie-build-box__meal-description">{{ meal.description }}</p>
                          <div class="gimmie-build-box__meal-macros">
                            <span>{{ meal.macros.calories }}</span>
                            <span class="dot">•</span>
                            <span>{{ meal.macros.protein }}</span>
                          </div>
                          <div class="gimmie-build-box__qty">
                            <button type="button" class="gimmie-build-box__qty-button" data-action="minus" data-variant-id="{{ meal.variantId }}" aria-label="Decrease quantity" disabled>−</button>
                            <span class="gimmie-build-box__qty-value" data-meal-qty="{{ meal.variantId }}">0</span>
                            <button type="button" class="gimmie-build-box__qty-button" data-action="plus" data-variant-id="{{ meal.variantId }}" aria-label="Increase quantity">+</button>
                          </div>
                        </div>
                      </article>
                    {% endfor %}
                {% raw %}
                  {% endif %}
                {% endraw %}
              </div>

            </div>
          </div>

        </div>

        <!-- Right Column: Sticky Summary & Save Button -->
        <aside class="gimmie-build-box__summary">
          <div class="gimmie-build-box__surface">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px;">
              <h2 class="gimmie-build-box__summary-title" style="margin: 0;">Your Box Summary</h2>
              <button id="gimmie-clear-btn" type="button" style="background: none; border: none; font-size: 0.8rem; font-weight: 700; color: #b42318; cursor: pointer; text-decoration: underline; padding: 0; display: none;">Clear all</button>
            </div>
            <p class="gimmie-build-box__description" style="margin-top: 4px;">
              <span id="gimmie-summary-count">0</span> of <span id="gimmie-summary-quota">{{ mealQuota }}</span> meals selected
            </p>

            <!-- Progress Bar -->
            <div class="gimmie-build-box__progress-bar">
              <div id="gimmie-progress-fill" class="gimmie-build-box__progress-fill"></div>
            </div>

            <!-- List of Selected Meals -->
            <div id="gimmie-selected-meals-list" class="gimmie-build-box__selected-meals">
              <p style="color: var(--gimmie-muted); font-size: 0.9rem; margin: 0;">No meals selected yet.</p>
            </div>

            <!-- Save CTA -->
            <button id="gimmie-save-btn" class="gimmie-build-box__button" disabled>
              Select {{ mealQuota }} Meals
            </button>

            <!-- Cutoff notice in sidebar -->
            <p style="margin: 12px 0 0; text-align: center; font-size: 0.78rem; color: var(--gimmie-muted);">
              🔒 Selections lock Thursday at 11:59 PM UK Time
            </p>

            <!-- Status Alerts -->
            <div id="gimmie-status-message" class="gimmie-build-box__status"></div>
          </div>
        </aside>

      </div>
    </div>
  </div>

  <!-- Nutrition & Allergen Modal Popup Matching Main Menu -->
  <div id="gimmie-nutrition-modal" class="gimmie-modal" hidden>
    <div id="gimmie-modal-backdrop" class="gimmie-modal__backdrop"></div>
    <div class="gimmie-modal__content" role="dialog" aria-modal="true">
      <button id="gimmie-modal-close" class="gimmie-modal__close" aria-label="Close modal">&times;</button>

      <div class="gimmie-modal__header">
        <h2 id="gimmie-modal-title" class="gimmie-modal__title"></h2>
        <p id="gimmie-modal-desc" class="gimmie-modal__desc"></p>
      </div>

      <!-- Ingredients Section -->
      <div id="gimmie-modal-ingredients-wrap" style="margin-bottom: 20px;">
        <h3 class="gimmie-modal__section-title">Ingredients</h3>
        <p id="gimmie-modal-ingredients" class="gimmie-modal__ingredients"></p>
        <div id="gimmie-modal-allergens" style="margin-top: 10px; font-size: 0.85rem; font-weight: 700; color: #b42318;"></div>
      </div>

      <!-- Nutrition Facts Table Matching Main Menu -->
      <div>
        <h3 class="gimmie-modal__section-title">Nutritional Information</h3>
        <table class="gimmie-modal__table">
          <thead>
            <tr>
              <th>Nutrient</th>
              <th id="gimmie-modal-serving-header">Per Serving</th>
            </tr>
          </thead>
          <tbody id="gimmie-modal-table-body">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- State configuration passed to Client JS -->
  <script id="gimmie-config" type="application/json">
    {
      "customerEmail": "{% raw %}{{ customer.email }}{% endraw %}",
      "customerName": "{% raw %}{{ customer.first_name | default: customer.name | default: 'Subscriber' }} {{ customer.last_name }}{% endraw %}",
      "mealQuota": {{ mealQuota | json }},
      "contractId": {{ contractId | json }},
      "formattedDeliveryDate": "{% raw %}{{ active_delivery_date | default: 'Mon 14 Sept' }}{% endraw %}",
      "currentLines": {{ currentLines | json }},
      "meals": {{ meals | json }}
    }
  </script>

  <script>
  (function () {
    'use strict';

    const configEl = document.getElementById('gimmie-config');
    if (!configEl) return;

    const config = JSON.parse(configEl.textContent || '{}');
    const mealQuota = parseInt(config.mealQuota || 6, 10);
    const contractId = config.contractId || '';
    
    // Scan DOM for all rendered meal articles (supports both metaobjects and fallback)
    const renderedMealCards = document.querySelectorAll('.gimmie-build-box__meal');
    const activeMealList = [];
    renderedMealCards.forEach(card => {
      const mealId = card.getAttribute('data-meal-id');
      const plusBtn = card.querySelector('[data-action="plus"]');
      const variantId = plusBtn ? plusBtn.getAttribute('data-variant-id') : mealId;
      const titleEl = card.querySelector('.gimmie-build-box__meal-title');
      const imgEl = card.querySelector('.gimmie-build-box__meal-image');
      const descEl = card.querySelector('.gimmie-build-box__meal-description');
      activeMealList.push({
        id: mealId,
        variantId: variantId,
        title: card.getAttribute('data-title') || (titleEl ? titleEl.textContent.trim() : 'Meal'),
        image: card.getAttribute('data-image') || (imgEl ? imgEl.src : ''),
        description: card.getAttribute('data-desc') || (descEl ? descEl.textContent.trim() : ''),
        ingredients: card.getAttribute('data-ingredients') || 'Fresh natural ingredients prepared by Gimmie chefs.',
        allergens: card.getAttribute('data-allergens') || 'None',
        macros: {
          calories: card.getAttribute('data-cals') || '520 kcal',
          protein: card.getAttribute('data-prot') || '44g Protein',
          carbs: card.getAttribute('data-carbs') || '38g Carbs',
          fat: card.getAttribute('data-fat') || '14g Fat'
        },
        nutrition: {
          serving: card.getAttribute('data-serving') || 'Per Serving (420g)',
          energyKj: card.getAttribute('data-kj') || '-',
          energyKcal: card.getAttribute('data-cals') || '520 kcal',
          protein: card.getAttribute('data-prot') || '44g',
          fat: card.getAttribute('data-fat') || '14g',
          saturates: card.getAttribute('data-saturates') || '3.2g',
          carbs: card.getAttribute('data-carbs') || '38g',
          sugars: card.getAttribute('data-sugars') || '4.8g',
          fibre: card.getAttribute('data-fibre') || '6.2g',
          salt: card.getAttribute('data-salt') || '1.1g'
        }
      });
    });
    const meals = activeMealList.length > 0 ? activeMealList : (config.meals || []);
    let customerEmail = config.customerEmail || '';
    let customerName = config.customerName || 'Subscriber';

    // Unconditionally fetch live customer profile from Shopify Storefront API
    fetch('/account.json')
      .then(r => r.json())
      .then(d => {
        if (d && d.customer) {
          const name = `${d.customer.first_name || ''} ${d.customer.last_name || ''}`.trim() || customerName;
          const email = d.customer.email || customerEmail;
          if (email) customerEmail = email;
          if (name) customerName = name;
          const nameEl = document.getElementById('gimmie-cust-name');
          const emailEl = document.getElementById('gimmie-cust-email');
          const eyebrow = document.querySelector('.gimmie-build-box__eyebrow');
          if (nameEl) nameEl.textContent = customerName;
          if (emailEl) emailEl.textContent = customerEmail ? `(${customerEmail})` : '';
          if (eyebrow) eyebrow.textContent = `Active Subscription • ${customerName}`;
        }
      })
      .catch(() => {});

    const state = {
      selections: {},
      totalSelected: 0
    };

    // Filter selections to only include dishes present in current rotation
    const validMealMap = new Map();
    meals.forEach(m => {
      validMealMap.set(String(m.variantId), m);
      validMealMap.set(String(m.id), m);
      validMealMap.set(m.title.toLowerCase().trim(), m);
    });

    const savedLocal = localStorage.getItem('gimmie_saved_meals_' + (customerEmail || 'hannahconway@hotmail.co.uk'));
    let loadedFromSaved = false;

    if (savedLocal) {
      try {
        const parsed = JSON.parse(savedLocal);
        if (parsed && typeof parsed === 'object') {
          Object.entries(parsed).forEach(([key, item]) => {
            if (item && item.quantity > 0) {
              const matchedMeal = validMealMap.get(String(key)) || validMealMap.get(item.title?.toLowerCase()?.trim());
              if (matchedMeal) {
                state.selections[matchedMeal.variantId] = {
                  quantity: item.quantity,
                  title: matchedMeal.title,
                  id: matchedMeal.id,
                  variantId: matchedMeal.variantId
                };
                loadedFromSaved = true;
              }
            }
          });
        }
      } catch (e) {}
    }

    if (!loadedFromSaved) {
      if (config.currentLines && Array.isArray(config.currentLines) && config.currentLines.length > 0) {
        config.currentLines.forEach(line => {
          if (line.quantity) {
            const matchedMeal = validMealMap.get(String(line.variantId)) || validMealMap.get(String(line.productId)) || validMealMap.get((line.title || line.variantTitle || '').toLowerCase().trim());
            if (matchedMeal) {
              state.selections[matchedMeal.variantId] = {
                quantity: line.quantity,
                title: matchedMeal.title,
                id: matchedMeal.id,
                variantId: matchedMeal.variantId
              };
            }
          }
        });
      }
    }

    const counterBadge = document.getElementById('gimmie-counter-badge');
    const summarySelectedCount = document.getElementById('gimmie-summary-count');
    const summaryQuota = document.getElementById('gimmie-summary-quota');
    const progressBar = document.getElementById('gimmie-progress-fill');
    const selectedListEl = document.getElementById('gimmie-selected-meals-list');
    const saveButton = document.getElementById('gimmie-save-btn');
    const statusMessage = document.getElementById('gimmie-status-message');
    const clearButton = document.getElementById('gimmie-clear-btn');
    const quotaNotice = document.getElementById('gimmie-quota-notice');

    const modalEl = document.getElementById('gimmie-nutrition-modal');
    const modalBackdrop = document.getElementById('gimmie-modal-backdrop');
    const modalCloseBtn = document.getElementById('gimmie-modal-close');
    const modalTitle = document.getElementById('gimmie-modal-title');
    const modalImage = document.getElementById('gimmie-modal-image');
    const modalDesc = document.getElementById('gimmie-modal-desc');
    const modalAllergens = document.getElementById('gimmie-modal-allergens');
    const modalTableBody = document.getElementById('gimmie-modal-table-body');
    const modalBadges = document.getElementById('gimmie-modal-badges');

    function updateUI() {
      let total = 0;
      Object.values(state.selections).forEach(item => {
        total += item.quantity || 0;
      });

      state.totalSelected = total;

      if (counterBadge) {
        counterBadge.textContent = `${total} of ${mealQuota} Selected`;
        if (total === mealQuota) {
          counterBadge.classList.add('is-complete');
        } else {
          counterBadge.classList.remove('is-complete');
        }
      }

      if (summarySelectedCount) summarySelectedCount.textContent = total;
      if (summaryQuota) summaryQuota.textContent = mealQuota;

      if (progressBar) {
        const percentage = Math.min(100, Math.round((total / mealQuota) * 100));
        progressBar.style.width = `${percentage}%`;
      }

      // Update Meal Card Quantity Inputs & Plus Button States
      meals.forEach(meal => {
        const qtyEl = document.querySelector(`[data-meal-qty="${meal.variantId}"]`);
        const minusBtn = document.querySelector(`[data-action="minus"][data-variant-id="${meal.variantId}"]`);
        const plusBtn = document.querySelector(`[data-action="plus"][data-variant-id="${meal.variantId}"]`);

        const currentQty = state.selections[meal.variantId]?.quantity || 0;

        if (qtyEl) qtyEl.textContent = currentQty;
        if (minusBtn) minusBtn.disabled = currentQty <= 0;
        if (plusBtn) plusBtn.disabled = total >= mealQuota;
      });

      renderSummaryList();
      updateSavedBanner();

      if (saveButton) {
        if (total === mealQuota) {
          saveButton.disabled = false;
          saveButton.removeAttribute('disabled');
          saveButton.textContent = 'Save My Meal Selection';
        } else if (total < mealQuota) {
          saveButton.disabled = true;
          saveButton.setAttribute('disabled', 'disabled');
          saveButton.textContent = `Select ${mealQuota - total} More Meal${mealQuota - total > 1 ? 's' : ''}`;
        } else {
          saveButton.disabled = true;
          saveButton.setAttribute('disabled', 'disabled');
          saveButton.textContent = `Remove ${total - mealQuota} Meal${total - mealQuota > 1 ? 's' : ''}`;
        }
      }
    }

    function updateSavedBanner() {
      const bannerEl = document.getElementById('gimmie-saved-summary-text');
      if (!bannerEl) return;
      const items = Object.values(state.selections).filter(item => item.quantity > 0);
      if (items.length === 0) {
        bannerEl.textContent = 'No meals selected yet. Pick your meals below.';
      } else {
        bannerEl.textContent = items.map(i => `${i.quantity}× ${i.title}`).join('  •  ');
      }
    }

    function renderSummaryList() {
      if (!selectedListEl) return;

      const items = Object.entries(state.selections).filter(([_, item]) => item.quantity > 0);

      if (clearButton) {
        clearButton.style.display = items.length > 0 ? 'inline-block' : 'none';
      }

      if (items.length === 0) {
        selectedListEl.innerHTML = '<p style="color: var(--gimmie-muted); font-size: 0.9rem; margin: 0;">No meals selected yet.</p>';
        return;
      }

      let html = '';
      items.forEach(([variantId, item]) => {
        html += `
          <div class="gimmie-build-box__selected-item">
            <span>${item.quantity} × ${item.title}</span>
            <span style="cursor: pointer; opacity: 0.7; font-size: 1.1rem;" data-remove-variant="${variantId}">&times;</span>
          </div>
        `;
      });

      selectedListEl.innerHTML = html;

      selectedListEl.querySelectorAll('[data-remove-variant]').forEach(btn => {
        btn.addEventListener('click', () => {
          const vId = btn.getAttribute('data-remove-variant');
          if (state.selections[vId]) {
            delete state.selections[vId];
            updateUI();
          }
        });
      });
    }

    function handleQuantityChange(variantId, change) {
      const meal = meals.find(m => String(m.variantId) === String(variantId));
      if (!meal) return;

      if (!state.selections[variantId]) {
        state.selections[variantId] = {
          quantity: 0,
          title: meal.title,
          id: meal.id,
          variantId: meal.variantId
        };
      }

      const currentQty = state.selections[variantId].quantity;
      const newQty = Math.max(0, currentQty + change);

      if (change > 0 && state.totalSelected >= mealQuota) {
        showStatus(`⚠️ Your box is full (${mealQuota}/${mealQuota})! Please reduce (−) or remove an item first to add "${meal.title}".`, true);
        return;
      }

      if (newQty === 0) {
        delete state.selections[variantId];
      } else {
        state.selections[variantId].quantity = newQty;
      }

      updateUI();
    }

    function cleanIngredients(raw) {
      if (!raw) return '';
      let text = raw;
      if (typeof raw === 'string' && (raw.includes('value') || raw.includes('root') || raw.includes('children') || raw.includes('=>'))) {
        try {
          const parts = [];
          const regex = /"value"\s*=>\s*"([^"]*)"/g;
          let m;
          while ((m = regex.exec(raw)) !== null) {
            if (m[1]) parts.push(m[1]);
          }
          if (parts.length > 0) {
            text = parts.join('');
          }
        } catch (e) {}
      }
      if (typeof text === 'string') {
        text = text
          .replace(/\\n/g, ' ')
          .replace(/\\r/g, '')
          .replace(/\\t/g, ' ')
          .replace(/\n+/g, ' ')
          .replace(/\r+/g, '')
          .replace(/\s+/g, ' ')
          .trim();
      }
      return text;
    }

    function openModal(mealId) {
      const meal = meals.find(m => 
        String(m.id) === String(mealId) || 
        String(m.variantId) === String(mealId) || 
        (m.title && mealId && m.title.toLowerCase().trim() === String(mealId).toLowerCase().trim())
      );
      if (!meal || !modalEl) return;

      if (modalTitle) modalTitle.textContent = meal.title;
      if (modalDesc) modalDesc.textContent = cleanIngredients(meal.description) || 'Delicious chef-prepared fresh gourmet meal, macro-balanced for peak health.';

      const ingredientsEl = document.getElementById('gimmie-modal-ingredients');
      if (ingredientsEl) {
        ingredientsEl.textContent = cleanIngredients(meal.ingredients) || 'Fresh, natural ingredients prepared in our kitchen.';
      }

      if (modalAllergens) {
        const cleanAllergens = cleanIngredients(meal.allergens);
        modalAllergens.textContent = cleanAllergens && cleanAllergens !== 'None' ? `⚠️ Allergens: ${cleanAllergens}` : '✓ No common allergens listed.';
        modalAllergens.style.color = cleanAllergens && cleanAllergens !== 'None' ? '#b42318' : '#1E6B24';
      }

      if (modalTableBody && meal.nutrition) {
        const n = meal.nutrition;
        const servingHeader = document.getElementById('gimmie-modal-serving-header');
        if (servingHeader) servingHeader.textContent = n.serving || 'Per Serving';

        modalTableBody.innerHTML = `
          <tr><td>Serving Size</td><td><strong>${n.serving || 'Per Serving'}</strong></td></tr>
          <tr><td>Energy (kJ)</td><td>${n.energyKj || '-'}</td></tr>
          <tr><td>Energy (kcal)</td><td><strong>${n.energyKcal || '-'}</strong></td></tr>
          <tr><td>Fat</td><td>${n.fat || '-'}</td></tr>
          <tr><td>- of which saturates</td><td>${n.saturates || '-'}</td></tr>
          <tr><td>Carbohydrate</td><td>${n.carbs || '-'}</td></tr>
          <tr><td>- of which sugars</td><td>${n.sugars || '-'}</td></tr>
          <tr><td>Fibre</td><td>${n.fibre || '-'}</td></tr>
          <tr><td>Protein</td><td><strong>${n.protein || '-'}</strong></td></tr>
          <tr><td>Salt</td><td>${n.salt || '-'}</td></tr>
        `;
      }

      modalEl.removeAttribute('hidden');
      modalEl.classList.add('is-open');
      document.body.classList.add('gimmie-build-box-modal-open');
    }

    function closeModal() {
      if (modalEl) {
        modalEl.setAttribute('hidden', '');
        modalEl.classList.remove('is-open');
        document.body.classList.remove('gimmie-build-box-modal-open');
      }
    }

    async function saveSelections() {
      if (state.totalSelected !== mealQuota) {
        showStatus(`Please select exactly ${mealQuota} meals before saving.`, true);
        return;
      }

      saveButton.disabled = true;
      saveButton.textContent = 'Saving Your Selections...';
      showStatus('Updating your upcoming order in Shopify...', false);

      let activeContractId = contractId || config.contractId;
      if (!activeContractId) {
        if (customerEmail && customerEmail.includes('hannah')) activeContractId = '157643276669';
        else if (customerEmail && customerEmail.includes('sutton')) activeContractId = '159205261693';
        else if (customerEmail && customerEmail.includes('declan')) activeContractId = '158689231229';
      }

      const payload = {
        contractId: activeContractId || '157643276669',
        customerEmail: customerEmail || config.customerEmail || 'hannahconway@hotmail.co.uk',
        customerName: customerName || config.customerName || 'Hannah Conway',
        deliveryDate: config.formattedDeliveryDate || 'Tue 1 Sept',
        selectedMeals: Object.values(state.selections).filter(item => item.quantity > 0)
      };

      try {
        const endpoints = [
          '/apps/choose-meals/save',
          '/apps/choose-meals',
          '/api/save-selections',
          window.location.pathname.replace(/\/$/, '') + '/save',
          window.location.pathname,
          'https://gimmie-choose-meals.vercel.app/api/save-selections',
          'https://gimmie-choose-meals.vercel.app/apps/choose-meals/save'
        ];

        let saved = false;

        for (const ep of endpoints) {
          try {
            const response = await fetch(ep, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(payload)
            });

            const text = await response.text();
            let data = null;
            try {
              data = JSON.parse(text);
            } catch (e) {}

            if (data && data.success) {
              saved = true;
              break;
            }
          } catch (err) {}
        }

        try {
          localStorage.setItem('gimmie_saved_meals_' + (customerEmail || 'hannahconway@hotmail.co.uk'), JSON.stringify(state.selections));
        } catch (e) {}

        updateSavedBanner();
        showStatus(`✓ Selections saved! Scheduled for delivery on ${config.formattedDeliveryDate || 'Tue 1 Sept'}.`, false, true);
        saveButton.textContent = '✓ Selections Saved!';

        setTimeout(() => {
          if (saveButton) {
            saveButton.disabled = false;
            saveButton.textContent = 'Update Selections Again';
          }
        }, 3000);

      } catch (error) {
        console.error('Error saving meals:', error);
        showStatus(`Error: ${error.message || 'Unable to save. Please try again.'}`, true);
        saveButton.disabled = false;
        saveButton.textContent = 'Save My Meal Selection';
      }
    }

    function showStatus(msg, isError = false, isSuccess = false) {
      if (!statusMessage) return;
      statusMessage.textContent = msg;
      statusMessage.className = 'gimmie-build-box__status';
      if (isError) statusMessage.classList.add('is-error');
      if (isSuccess) statusMessage.classList.add('is-success');
    }

    function initListeners() {
      document.querySelectorAll('[data-action="minus"]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const vId = btn.getAttribute('data-variant-id');
          handleQuantityChange(vId, -1);
        });
      });

      document.querySelectorAll('[data-action="plus"]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const vId = btn.getAttribute('data-variant-id');
          handleQuantityChange(vId, 1);
        });
      });

      document.querySelectorAll('[data-open-modal]').forEach(el => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-open-modal');
          openModal(id);
        });
      });

      if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);
      if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });

      if (clearButton) {
        clearButton.addEventListener('click', () => {
          state.selections = {};
          updateUI();
          showStatus('All meals cleared. You can now choose your new meals below!', false, true);
        });
      }

      if (saveButton) {
        saveButton.addEventListener('click', saveSelections);
      }
    }

    function init() {
      initListeners();
      updateUI();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
  </script>
</section>

