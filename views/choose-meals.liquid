          ingredients: 'Atlantic Salmon (Fish) (35%), Sushi Rice (35%), Edamame Beans (Soya), Cucumber, Pickled Ginger, Sesame Oil, Toasted Sesame Seeds, Tamari Soy Sauce (Soya, Wheat), Spring Onions.',
          allergens: 'Fish, Soya, Sesame, Wheat'
        };
      } else if (titleLower.includes('cajun') || titleLower.includes('penne')) {
        fallbackDish = {
          desc: 'Spicy Cajun chicken and chorizo penne, tossed in a creamy sauce with mushrooms and garden peas. Finished with fresh parsley and parmesan.',
          ingredients: 'Chicken Breast (35%), Penne Pasta (Durum Wheat Semolina), Double Cream (Milk), Chorizo (Pork, Paprika, Salt, Garlic), Mushrooms, Peas, Parmesan (Milk), Cajun Seasoning, Celery Salt, Mustard Seed.',
          allergens: 'Wheat, Milk, Celery, Mustard'
        };
      } else if (titleLower.includes('oats') || titleLower.includes('porridge')) {
        fallbackDish = {
          desc: (item.description && item.description.length > 20 && !item.description.includes('root') && !item.description.includes('gourmet')) ? item.description : 'Creamy, nutrient-rich overnight oats blended with premium whey protein, chia seeds, and whole ingredients.',
          ingredients: 'Rolled Oats (Gluten) (40%), Skimmed Milk (25%), Greek Style Yoghurt (Milk) (15%), Whey Protein Concentrate (Milk, Soy Lecithin) (10%), Chia Seeds, Natural Flavouring.',
          allergens: 'Milk, Gluten (Oats), Soya',
          nutrition: {
            serving: 'Per Pot (300g)',
            energyKj: '1680 kJ',
            energyKcal: '400 kcal',
            fat: '8.0g',
            saturates: '2.5g',
            carbs: '50.0g',
            sugars: '12.0g',
            fibre: '6.0g',
            protein: '32.0g',
            salt: '0.25g'
          }
        };
      }

      // Dynamic regex extraction from product description for custom/new store products
      const descToParse = (card ? card.getAttribute('data-desc') : '') || item.description || '';
      if (descToParse) {
        const ingMatch = descToParse.match(/ingredients?:?\s*([^.\n<]+(?:\.[^.\n<]+)*)/i);
        const allerMatch = descToParse.match(/allergens?:?\s*([^.\n<]+)/i);
        if ((!cleanIng || cleanIng.length < 5 || cleanIng.includes('wholesome')) && ingMatch && ingMatch[1] && ingMatch[1].trim().length > 5) {
          cleanIng = ingMatch[1].trim();
          item.ingredients = cleanIng;
        }
        if ((!cleanAller || cleanAller === 'None' || cleanAller === '') && allerMatch && allerMatch[1] && allerMatch[1].trim().length > 1) {
          cleanAller = allerMatch[1].trim();
          item.allergens = cleanAller;
        }
      }

      if (modalTitle) modalTitle.textContent = rawTitle || item.title;

      // 1. Description: Prioritize 100% Dynamic Product Description from Metafield
      if (modalDesc) {
        let finalDesc = cleanDesc;
        if (finalDesc && (finalDesc.includes('root') || finalDesc.includes('Freshly prepared delicious'))) {
          finalDesc = '';
        }
        if (finalDesc) {
          const shortDesc = finalDesc.split(/ingredients?:/i)[0].split(/allergens?:/i)[0].trim();
          modalDesc.textContent = shortDesc || finalDesc;
        } else if (fallbackDish && fallbackDish.desc) {
          modalDesc.textContent = fallbackDish.desc;
        } else {
          modalDesc.textContent = 'Chef-crafted dish prepared fresh with pure natural ingredients.';
        }
      }

      // 2. Ingredients: Prioritize 100% Dynamic Product Ingredients from Metafield (Rich HTML preserved)
      const ingredientsEl = document.getElementById('gimmie-modal-ingredients');
      if (ingredientsEl) {
        let rawIng = rawIngVal || item.ingredients || '';
        let processedIng = cleanRichIngredients(rawIng);
        if (processedIng && processedIng.length > 5 && !processedIng.includes('root') && !processedIng.includes('children') && !processedIng.includes('wholesome ingredients') && !processedIng.includes('Fresh, wholesome')) {
          ingredientsEl.innerHTML = processedIng;
        } else if (fallbackDish && fallbackDish.ingredients) {
          ingredientsEl.innerHTML = fallbackDish.ingredients;
        } else {
          ingredientsEl.innerHTML = processedIng || 'Fresh natural ingredients prepared in our kitchen.';
        }
      }

      // 3. Allergens: Prioritize 100% Dynamic Product Allergens from Metafield (Exact build-your-box style, no warning emoji)
      if (modalAllergens) {
        let rawAller = rawAllerVal || item.allergens || '';
        if (rawAller && rawAller !== 'None' && rawAller !== '' && !rawAller.includes('root')) {
          modalAllergens.textContent = cleanIngredients(rawAller);
        } else if (fallbackDish && fallbackDish.allergens && fallbackDish.allergens !== 'None') {
          modalAllergens.textContent = fallbackDish.allergens;
        } else {
          modalAllergens.textContent = 'None';
        }
      }

      // 4. Nutritional facts: Check if item has dynamic nutrition attributes from Shopify Metafield
      const rawNutr = item.nutrition || {};
      const c = card;
      const cardVal = (attr) => {
        if (!c) return '';
        const v = c.getAttribute(attr);
        if (!v || v === 'null' || v === 'undefined' || v === '-' || v.trim() === '' || v.trim().toLowerCase() === 'g' || v.trim().toLowerCase() === 'g protein') {
          return '';
        }
        return v.trim();
      };

      // Also dynamically regex-extract macros from description text if missing
      const descCals = descToParse ? (descToParse.match(/(\d+)\s*kcal/i) || [])[1] : null;
      const descProt = descToParse ? (descToParse.match(/(\d+(?:\.\d+)?)\s*g?\s*protein/i) || [])[1] : null;
      const descFat = descToParse ? (descToParse.match(/(\d+(?:\.\d+)?)\s*g?\s*fat/i) || [])[1] : null;
      const descCarbs = descToParse ? (descToParse.match(/(\d+(?:\.\d+)?)\s*g?\s*carbs/i) || [])[1] : null;
      const descFib = descToParse ? (descToParse.match(/(\d+(?:\.\d+)?)\s*g?\s*(?:fibre|fiber)/i) || [])[1] : null;
      const descSalt = descToParse ? (descToParse.match(/(\d+(?:\.\d+)?)\s*g?\s*salt/i) || [])[1] : null;

      const rawKj = cardVal('data-kj') || rawNutr.energyKj || rawNutr.kj || '';
      const rawCals = cardVal('data-cals') || rawNutr.energyKcal || rawNutr.calories || (item.macros && item.macros.calories) || (descCals ? `${descCals} kcal` : '') || '';
      const rawFat = cardVal('data-fat') || rawNutr.fat || (item.macros && item.macros.fat) || (descFat ? `${descFat}g` : '') || (fallbackDish && fallbackDish.nutrition && fallbackDish.nutrition.fat) || '';
      const rawSat = cardVal('data-saturates') || rawNutr.saturates || (fallbackDish && fallbackDish.nutrition && fallbackDish.nutrition.saturates) || '';
      const rawCarbs = cardVal('data-carbs') || rawNutr.carbs || (item.macros && item.macros.carbs) || (descCarbs ? `${descCarbs}g` : '') || (fallbackDish && fallbackDish.nutrition && fallbackDish.nutrition.carbs) || '';
      const rawSug = cardVal('data-sugars') || rawNutr.sugars || (fallbackDish && fallbackDish.nutrition && fallbackDish.nutrition.sugars) || '';
      const rawFib = cardVal('data-fibre') || rawNutr.fibre || (descFib ? `${descFib}g` : '') || (fallbackDish && fallbackDish.nutrition && fallbackDish.nutrition.fibre) || '';
      const rawProt = cardVal('data-prot') || rawNutr.protein || (item.macros && item.macros.protein) || (descProt ? `${descProt}g` : '') || (fallbackDish && fallbackDish.nutrition && fallbackDish.nutrition.protein) || '';
      const rawSalt = cardVal('data-salt') || rawNutr.salt || (descSalt ? `${descSalt}g` : '') || (fallbackDish && fallbackDish.nutrition && fallbackDish.nutrition.salt) || '';

      let energyDisplay = '';
      const combinedEnergy = (rawKj && rawKj.includes('/')) ? rawKj : ((rawCals && rawCals.includes('/')) ? rawCals : '');
      if (combinedEnergy) {
        energyDisplay = combinedEnergy.replace(/\s+/g, ' ').trim();
      } else {
        let cleanKjNum = null;
        let cleanKcalNum = null;

        if (rawKj) {
          const m = String(rawKj).match(/(\d+(?:\.\d+)?)/);
          if (m) cleanKjNum = Math.round(parseFloat(m[1]));
        }
        if (rawCals) {
          const m = String(rawCals).match(/(\d+(?:\.\d+)?)/);
          if (m) cleanKcalNum = Math.round(parseFloat(m[1]));
        }

        if (cleanKjNum && !cleanKcalNum) {
          cleanKcalNum = Math.round(cleanKjNum / 4.184);
        } else if (cleanKcalNum && !cleanKjNum) {
          cleanKjNum = Math.round(cleanKcalNum * 4.184);
        }

        if (cleanKjNum && cleanKcalNum) {
          energyDisplay = `${cleanKjNum} kj / ${cleanKcalNum} kcal`;
        } else if (cleanKcalNum) {
          energyDisplay = `${cleanKcalNum} kcal`;
        } else if (fallbackDish && fallbackDish.nutrition && (fallbackDish.nutrition.energyKj || fallbackDish.nutrition.energyKcal)) {
          const fbKj = (fallbackDish.nutrition.energyKj || '').replace(/kj/i, '').trim();
          const fbKcal = (fallbackDish.nutrition.energyKcal || '').replace(/kcal/i, '').trim();
          if (fbKj && fbKcal) {
            energyDisplay = `${fbKj} kj / ${fbKcal} kcal`;
          } else {
            energyDisplay = fbKcal ? `${fbKcal} kcal` : (fbKj ? `${fbKj} kj` : '-');
          }
        } else {
          energyDisplay = '-';
        }
      }

      const formatGramVal = (val, wordToRemove) => {
        if (!val || val === '-' || val === 'null' || val === 'undefined') return '-';
        let str = String(val).trim();
        str = str.replace(/[#]/g, '').trim();
        if (wordToRemove) {
          str = str.replace(new RegExp(wordToRemove, 'i'), '').trim();
        }
        str = str.replace(/g$/i, '').trim();
        if (str === '' || isNaN(parseFloat(str))) return '-';
        if (!isNaN(parseFloat(str)) && isFinite(str)) {
          return str + 'g';
        }
        return str;
      };

      const cleanFat = formatGramVal(rawFat, 'fat');
      const cleanSat = formatGramVal(rawSat);
      const cleanCarbs = formatGramVal(rawCarbs, 'carbs?');
      const cleanSug = formatGramVal(rawSug);
      const cleanFib = formatGramVal(rawFib);
      const cleanProt = formatGramVal(rawProt, 'protein');
      const cleanSalt = formatGramVal(rawSalt);

      if (modalTableBody) {
        modalTableBody.innerHTML = `
          <tr>
            <th scope="row">Energy</th>
            <td>${energyDisplay}</td>
          </tr>
          <tr>
            <th scope="row">Fat</th>
            <td>${cleanFat}</td>
          </tr>
          <tr class="gimmie-build-box__nutrition-child-row">
            <th scope="row">of which saturates</th>
            <td>${cleanSat}</td>
          </tr>
          <tr>
            <th scope="row">Carbohydrates</th>
            <td>${cleanCarbs}</td>
          </tr>
          <tr class="gimmie-build-box__nutrition-child-row">
            <th scope="row">of which sugars</th>
            <td>${cleanSug}</td>
          </tr>
          <tr>
            <th scope="row">Fibre</th>
            <td>${cleanFib}</td>
          </tr>
          <tr>
            <th scope="row">Protein</th>
            <td>${cleanProt}</td>
          </tr>
          <tr>
            <th scope="row">Salt</th>
            <td>${cleanSalt}</td>
          </tr>
        `;
      }

      modalEl.removeAttribute('hidden');
      modalEl.classList.add('is-open');
      modalEl.style.display = 'flex';
      modalEl.style.zIndex = '9999999';
      document.body.classList.add('gimmie-build-box-modal-open');
      const scrollSurface = modalEl.querySelector('.gimmie-build-box__meal-modal-surface, .gimmie-modal__content');
      if (scrollSurface) scrollSurface.scrollTop = 0;
    }

    function closeModal() {
      if (modalEl) {
        modalEl.setAttribute('hidden', '');
        modalEl.classList.remove('is-open');
        modalEl.style.display = 'none';
        document.body.classList.remove('gimmie-build-box-modal-open');
      }
    }

    async function saveSelections() {
      if (isCutoffPassed) {
        showStatus(`🔒 Cut-off has passed for delivery on ${config.formattedDeliveryDate}. Your order is locked for kitchen prep and cannot be edited.`, true);
        return;
      }

      if (state.totalSelected !== mealQuota) {
        showStatus(`Please select exactly ${mealQuota} meals before saving.`, true);
        return;
      }

      saveButton.disabled = true;
      saveButton.textContent = 'Saving Your Selections...';
      showStatus('Updating your upcoming order in Shopify...', false);

      let activeContractId = contractId || config.contractId;
      if (!activeContractId) {
        if (customerEmail && customerEmail.includes('hannah')) activeContractId = '157643276669';
        else if (customerEmail && customerEmail.includes('sutton')) activeContractId = '159205261693';
        else if (customerEmail && customerEmail.includes('declan')) activeContractId = '158689231229';
      }

      const payload = {
        contractId: activeContractId || '157643276669',
        customerEmail: customerEmail || config.customerEmail || 'hannahconway@hotmail.co.uk',
        customerName: customerName || config.customerName || 'Hannah Conway',
        deliveryDate: config.formattedDeliveryDate || 'Upcoming Monday',
        isCutoffPassed: isCutoffPassed,
        isDuplicateTheme: config.isDuplicateTheme || false,
        selectedMeals: Object.values(state.selections).filter(item => item.quantity > 0),
        selectedAddons: Object.values(state.addonSelections).filter(item => item.quantity > 0).map(item => {
            const q = parseInt(item.quantity, 10);
            const uPrice = parseFloat(item.unitPrice || item.price) || 0;
            const origPrice = parseFloat(item.originalPrice || uPrice) || uPrice;
            const lTotal = (q * uPrice).toFixed(2);
            return {
              id: item.id,
              variantId: item.variantId,
              title: item.title,
              quantity: q,
              unitPrice: uPrice.toFixed(2),
              price: uPrice.toFixed(2),
              originalPrice: origPrice.toFixed(2),
              lineTotal: lTotal,
              discountPercent: item.discountPercent || (state.activeDiscount ? state.activeDiscount.percent : 0)
            };
          }),
        addonsTotal: state.totalAddonsPrice.toFixed(2),
        addonsEnabled: state.addonsEnabled,
        discountCode: (state.activeDiscount && state.activeDiscount.valid) ? state.activeDiscount.code : null
      };

      try {
        const endpoints = [
          '/apps/choose-meals/save',
          '/apps/choose-meals',
          '/api/save-selections',
          window.location.pathname.replace(/\/$/, '') + '/save',
          window.location.pathname,
          'https://gimmie-choose-meals.vercel.app/api/save-selections',
          'https://gimmie-choose-meals.vercel.app/apps/choose-meals/save'
        ];

        let saved = false;

        for (const ep of endpoints) {
          try {
            const response = await fetch(ep, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(payload)
            });

            const text = await response.text();
            let data = null;
            try {
              data = JSON.parse(text);
            } catch (e) {}

            if (data && data.success) {
              saved = true;
              break;
            }
          } catch (err) {}
        }

        try {
          const deliveryKey = (config.formattedDeliveryDate || '').replace(/[^a-zA-Z0-9]/g, '');
          const storageKey = 'gimmie_saved_meals_' + (customerEmail || 'hannahconway@hotmail.co.uk') + '_' + deliveryKey;
          localStorage.setItem(storageKey, JSON.stringify({
            meals: state.selections,
            addons: state.addonSelections,
            addonsEnabled: state.addonsEnabled
          }));
        } catch (e) {}

        updateSavedBanner();
        const successMsg = state.totalAddons > 0
          ? `✓ Selections & ${state.totalAddons} add-ons saved for delivery on ${config.formattedDeliveryDate || 'upcoming Monday'}.`
          : `✓ Selections saved! Scheduled for delivery on ${config.formattedDeliveryDate || 'upcoming Monday'}.`;
        showStatus(successMsg, false, true);
        saveButton.textContent = '✓ Selections Saved!';

        setTimeout(() => {
          if (saveButton) {
            saveButton.disabled = false;
            saveButton.textContent = 'Update Selections Again';
          }
        }, 3000);

      } catch (error) {
        console.error('Error saving meals:', error);
        showStatus(`Error: ${error.message || 'Unable to save. Please try again.'}`, true);
        saveButton.disabled = false;
        saveButton.textContent = 'Save My Meal Selection';
      }
    }

    function showStatus(msg, isError = false, isSuccess = false) {
      if (!statusMessage) return;
      statusMessage.textContent = msg;
      statusMessage.className = 'gimmie-build-box__status';
      if (isError) statusMessage.classList.add('is-error');
      if (isSuccess) statusMessage.classList.add('is-success');
    }

    function initListeners() {
      // Meal quantity buttons
      document.querySelectorAll('[data-action="minus"]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const vId = btn.getAttribute('data-variant-id');
          handleQuantityChange(vId, -1);
        });
      });

      document.querySelectorAll('[data-action="plus"]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const vId = btn.getAttribute('data-variant-id');
          handleQuantityChange(vId, 1);
        });
      });

      // Add-on quantity buttons (direct listener)
      document.querySelectorAll('[data-addon-action="minus"]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const aId = btn.getAttribute('data-addon-id');
          handleAddonQuantityChange(aId, -1);
        });
      });

      document.querySelectorAll('[data-addon-action="plus"]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const aId = btn.getAttribute('data-addon-id');
          handleAddonQuantityChange(aId, 1);
        });
      });

      // Global click delegation to guarantee clicks are never missed
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-addon-action]');
        if (!btn) return;
        if (btn.disabled || btn.getAttribute('disabled') !== null) return;
        e.preventDefault();
        e.stopPropagation();
        const action = btn.getAttribute('data-addon-action');
        const aId = btn.getAttribute('data-addon-id');
        if (!aId) return;
        if (action === 'plus') {
          handleAddonQuantityChange(aId, 1);
        } else if (action === 'minus') {
          handleAddonQuantityChange(aId, -1);
        }
      });

      // Add-on Carousel Navigation Arrows (Desktop Slider)
      const track = document.getElementById('s4t1') || document.getElementById('gimmie-addon-track');
      const prevBtn = document.getElementById('gimmie-addon-prev');
      const nextBtn = document.getElementById('gimmie-addon-next');

      function updateSliderArrows() {
        if (!track || !prevBtn || !nextBtn) return;
        const maxScroll = track.scrollWidth - track.clientWidth;
        prevBtn.disabled = track.scrollLeft <= 5;
        nextBtn.disabled = track.scrollLeft >= maxScroll - 5;
      }

      if (prevBtn && track) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const scrollDist = track.clientWidth * 0.75;
          track.scrollBy({ left: -scrollDist, behavior: 'smooth' });
        });
      }
      if (nextBtn && track) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const scrollDist = track.clientWidth * 0.75;
          track.scrollBy({ left: scrollDist, behavior: 'smooth' });
        });
      }
      if (track) {
        track.addEventListener('scroll', updateSliderArrows, { passive: true });
        window.addEventListener('resize', updateSliderArrows);
        setTimeout(updateSliderArrows, 300);
      }

      // Modal trigger for meals and add-ons (direct listeners)
      document.querySelectorAll('[data-open-modal]').forEach(el => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const id = el.getAttribute('data-open-modal');
          openModal(id, el);
        });
      });

      // Global delegation backup: clicking any [data-open-modal] or its child (svg, text)
      document.addEventListener('click', (e) => {
        const trigger = e.target.closest('[data-open-modal]');
        if (trigger) {
          e.preventDefault();
          e.stopPropagation();
          const id = trigger.getAttribute('data-open-modal');
          openModal(id, trigger);
        }
      });

      if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);
      if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
      document.addEventListener('click', (e) => {
        if (e.target.closest('#gimmie-modal-close, [data-gimmie-build-meal-close], #gimmie-modal-backdrop')) {
          closeModal();
        }
      });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });

      if (clearButton) {
        clearButton.addEventListener('click', () => {
          state.selections = {};
          state.addonSelections = {};
          updateUI();
          showStatus('All meals and add-ons cleared. You can now choose your new items below!', false, true);
        });
      }

      if (saveButton) {
        saveButton.addEventListener('click', saveSelections);
      }
    }

    // =========================================================================
    // DYNAMIC DISCOUNT & STRIKETHROUGH ENGINE (EXACT MATCH TO BUILD YOUR BOX)
    // =========================================================================
    const boxPricingTable = {
      6: { original: 48.00, formatted: '£48.00' },
      8: { original: 64.00, formatted: '£64.00' },
      10: { original: 80.00, formatted: '£80.00' }
    };

    function applyAddonDiscounts(discountData) {
      let activeDiscount = discountData || (state.activeDiscount && state.activeDiscount.valid ? state.activeDiscount : null);

      const discountPercent = (activeDiscount && activeDiscount.valid) ? (parseFloat(activeDiscount.percent) || 0) : 0;
      const discountFactor = discountPercent > 0 ? Math.max(0, (100 - discountPercent) / 100) : 1;

      const addonCards = document.querySelectorAll('.gimmie-build-box__addon-item, [data-gimmie-addonmeal]');
      addonCards.forEach(card => {
        const rawPrice = card.getAttribute('data-price') || card.getAttribute('data-addonmeal-price') || '8.00';
        let originalPrice = parseFloat(String(rawPrice).replace(/[^0-9.]/g, '')) || 8.00;
        if (originalPrice >= 100 && !String(rawPrice).includes('.')) {
          originalPrice = originalPrice / 100;
        }

        const discountedPrice = originalPrice * discountFactor;

        // Locate price elements on add-on card
        const priceContainer = card.querySelector('.price__regular') || card.querySelector('.gimmie-build-box__price');
        let compareEl = card.querySelector('.price-item--compare');
        let currentEl = card.querySelector('.price-item--regular');

        if (!compareEl && priceContainer) {
          compareEl = document.createElement('span');
          compareEl.className = 'price-item price-item--compare font-heading uppercase';
          if (currentEl) {
            priceContainer.insertBefore(compareEl, currentEl);
          } else {
            priceContainer.appendChild(compareEl);
          }
        }

        // Remove % discount badge from add-on cards as requested (clean slashed original + bold discounted price)
        const badgeEl = card.querySelector('.price-item--discount-badge');
        if (badgeEl) {
          badgeEl.remove();
        }

        if (discountPercent > 0) {
          // Discount returned by App/contract: show slashed original price and discounted rate
          if (compareEl) {
            compareEl.textContent = '£' + originalPrice.toFixed(2);
            compareEl.style.display = 'inline-block';
          }
          if (currentEl) {
            currentEl.textContent = '£' + discountedPrice.toFixed(2);
            currentEl.style.fontWeight = '800';
          }
        } else {
          // Native pricing from App/Shopify: clean price, no slash
          if (compareEl) {
            compareEl.style.display = 'none';
          }
          if (currentEl) {
            currentEl.textContent = '£' + originalPrice.toFixed(2);
            currentEl.style.fontWeight = '700';
          }
        }

        // Update effective price in addons data array
        const cardId = card.getAttribute('data-addon-id') || card.getAttribute('data-addonmeal-id') || card.getAttribute('data-meal-id');
        const matched = addons.find(a => String(a.variantId) === String(cardId) || String(a.id) === String(cardId));
        if (matched) {
          matched.originalPrice = originalPrice;
          matched.price = discountPercent > 0 ? discountedPrice : originalPrice;
          matched.discountPercent = discountPercent;
        }
      });

      // Update state.addonSelections items with new effective price
      Object.keys(state.addonSelections).forEach(id => {
        const item = state.addonSelections[id];
        const matched = addons.find(a => String(a.variantId) === String(id) || String(a.id) === String(id));
        if (matched) {
          item.price = matched.price;
          item.originalPrice = matched.originalPrice;
          item.discountPercent = matched.discountPercent;
        }
      });

      updateUI();
    }

    function extractDiscountFromTags(tags) {
      if (!tags) return null;
      let tagList = [];
      if (Array.isArray(tags)) {
        tagList = tags;
      } else if (typeof tags === 'string') {
        tagList = tags.split(',').map(t => t.trim());
      }
      
      for (const rawTag of tagList) {
        const t = String(rawTag).trim();
        // Match discount-5, discount-10, discount-15, discount-20, discount-25, discount-30, discount-X, discount_X, X%-off
        const match = t.match(/discount[-_]?(\d+)/i) || t.match(/^(\d+)%[-_]?off$/i);
        if (match) {
          const p = parseInt(match[1], 10);
          if (p > 0 && p <= 90) {
            return {
              code: t,
              percent: p,
              title: `${p}% OFF`,
              valid: true
            };
          }
        }
      }

      for (const rawTag of tagList) {
        const u = String(rawTag).trim().toUpperCase();
        if (u === 'GIMMIEAGO') return { code: 'GIMMIEAGO', percent: 15, title: '15% OFF', valid: true };
        if (u === 'HOY25') return { code: 'HOY25', percent: 25, title: '25% OFF', valid: true };
        if (u === 'WELCOME15') return { code: 'WELCOME15', percent: 15, title: '15% OFF', valid: true };
        if (u === 'VIP20') return { code: 'VIP20', percent: 20, title: '20% OFF', valid: true };
        if (u === 'SAVE10') return { code: 'SAVE10', percent: 10, title: '10% OFF', valid: true };
      }

      return null;
    }

    function applyDynamicBoxDiscount(discountData) {
      const quota = parseInt(config.mealQuota || 6, 10);
      const baseInfo = boxPricingTable[quota] || { original: quota * 8.00, formatted: '£' + (quota * 8.00).toFixed(2) };
      
      const boxCompareEl = document.getElementById('gimmie-summary-box-compare');
      const boxCurrentEl = document.getElementById('gimmie-summary-box-current');
      const grandTotalCompareEl = document.getElementById('gimmie-summary-grand-total-compare');
      const grandTotalEl = document.getElementById('gimmie-summary-grand-total');
      const discountBadgeEl = document.getElementById('gimmie-summary-discount-badge');

      if (!boxCurrentEl) return;

      if (!discountData || !discountData.valid) {
        // No discount applied: full regular price, hide strikethrough compare-at price
        state.activeDiscount = null;
        if (boxCompareEl) boxCompareEl.style.display = 'none';
        boxCurrentEl.textContent = baseInfo.formatted;
        if (grandTotalCompareEl) grandTotalCompareEl.style.display = 'none';
        if (discountBadgeEl) discountBadgeEl.style.display = 'none';
        applyAddonDiscounts(null);
        if (grandTotalEl) grandTotalEl.textContent = '£' + (baseInfo.original + (state.totalAddonsPrice || 0)).toFixed(2);
        return;
      }

      state.activeDiscount = discountData;

      // Valid discount: calculate slashed original price and discounted final price
      const percent = parseFloat(discountData.percent) || 0;
      const discountFactor = Math.max(0, (100 - percent) / 100);
      const finalPrice = baseInfo.original * discountFactor;

      // Strike out the original box price with slash, show new discounted price
      if (boxCompareEl) {
        boxCompareEl.textContent = baseInfo.formatted;
        boxCompareEl.style.display = 'inline-block';
      }
      boxCurrentEl.textContent = '£' + finalPrice.toFixed(2);

      // Auto-apply subscriber discount to add-ons
      applyAddonDiscounts(discountData);

      // Update Grand Total with compare-at price
      const origGrandTotal = baseInfo.original + (state.totalAddonsOriginalPrice || state.totalAddonsPrice || 0);
      const finalGrandTotal = finalPrice + (state.totalAddonsPrice || 0);

      if (grandTotalCompareEl) {
        if (origGrandTotal > finalGrandTotal) {
          grandTotalCompareEl.textContent = '£' + origGrandTotal.toFixed(2);
          grandTotalCompareEl.style.display = 'inline-block';
        } else {
          grandTotalCompareEl.style.display = 'none';
        }
      }
      if (grandTotalEl) {
        grandTotalEl.textContent = '£' + finalGrandTotal.toFixed(2);
      }
      if (discountBadgeEl) {
        discountBadgeEl.textContent = `${percent}% OFF APPLIED`;
        discountBadgeEl.style.display = 'inline-block';
      }
    }

    async function evaluateDiscountCode(rawCode) {
      if (!rawCode) return { valid: false };

      let code = '';
      let percent = 0;

      if (typeof rawCode === 'object') {
        if (rawCode.valid && rawCode.percent) return rawCode;
        code = String(rawCode.title || rawCode.code || rawCode.name || '').trim();
        percent = parseFloat(rawCode.percent || rawCode.value || rawCode.percentage || 0);
      } else {
        code = String(rawCode).replace(/\s+/g, '').trim();
      }

      // Check discount-5, discount-10, discount-15, discount-20, discount-25, discount-30, etc.
      const match = code.match(/discount[-_]?(\d+)/i) || code.match(/^(\d+)%[-_]?off$/i);
      if (match) {
        percent = parseInt(match[1], 10);
      }

      if (!percent || isNaN(percent) || percent <= 0) {
        const uCode = code.toUpperCase();
        if (uCode === 'GIMMIEAGO') {
          percent = 15; // Recurring subscriber discount for weekly meal picker
        } else if (uCode === 'HOY25') {
          percent = 25;
        } else if (uCode === 'WELCOME15') {
          percent = 15;
        } else if (uCode === 'VIP20') {
          percent = 20;
        } else if (uCode === 'SAVE10') {
          percent = 10;
        } else {
          const numMatch = code.match(/(\d{1,2})/);
          if (numMatch) {
            const p = parseInt(numMatch[1], 10);
            if (p >= 1 && p <= 90) percent = p;
          }
        }
      }

      if (percent > 0) {
        return { valid: true, code: code || `${percent}% OFF`, percent: percent, title: `${percent}% OFF` };
      }

      return { valid: false, code: code };
    }

    function initDiscountUI() {
      const urlParams = new URLSearchParams(window.location.search);
      const discountParam = urlParams.get('discount') || urlParams.get('code') || urlParams.get('discount_code');

      // 1. URL parameter override
      if (discountParam) {
        evaluateDiscountCode(discountParam).then(result => {
          applyDynamicBoxDiscount(result);
        });
        return;
      }

      // Read fallback from DOM if config tags missing
      const domDataEl = document.getElementById('gimmie-customer-tag-data');
      const domDiscountTag = domDataEl ? domDataEl.getAttribute('data-discount-tag') : '';
      const domTags = domDataEl ? (domDataEl.getAttribute('data-tags') || '').split(',') : [];

      // 2. Customer tag discount from Shopify storefront liquid config or DOM (e.g. discount-5, discount-10, discount-15, discount-20, discount-25, discount-30)
      const tagDiscount = extractDiscountFromTags(
        (Array.isArray(config.customerTags) && config.customerTags.length > 0) ? config.customerTags : 
        (config.customerDiscountTag || domDiscountTag || domTags)
      );
      if (tagDiscount && tagDiscount.valid) {
        applyDynamicBoxDiscount(tagDiscount);
        return;
      }

      // 3. Discount passed from backend subscription contract / Appstle / Shopify Admin
      if (config.discount) {
        evaluateDiscountCode(config.discount).then(result => {
          applyDynamicBoxDiscount(result);
        });
        return;
      }

      // 4. Default: No discount
      applyDynamicBoxDiscount(null);
    }

    function init() {
      initListeners();
      updateUI();
      initDiscountUI();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
</section>

