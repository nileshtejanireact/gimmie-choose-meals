  <!-- Hidden Container for Printing -->
  <div id="print-area" class="print-only"></div>

  <script>
    const submissionsData = {{ submissions | json }};
    const contractsData = {{ contracts | json }};

    // Tab Navigation
    function switchTab(tabId) {
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

      const activeBtn = document.querySelector(`.tab-btn[onclick*="${tabId}"]`);
      const activeContent = document.getElementById(`tab-${tabId}`);

      if (activeBtn) activeBtn.classList.add('active');
      if (activeContent) activeContent.classList.add('active');
    }

    function showAlert(message, type = 'success') {
      const banner = document.getElementById('alert-banner');
      if (!banner) return;
      banner.style.display = 'block';
      banner.textContent = message;
      if (type === 'success') {
        banner.style.background = '#e3f1df';
        banner.style.color = '#108043';
        banner.style.border = '1px solid #108043';
      } else {
        banner.style.background = '#fedcd8';
        banner.style.color = '#d82c0d';
        banner.style.border = '1px solid #d82c0d';
      }
      setTimeout(() => {
        banner.style.display = 'none';
      }, 6000);
    }

    // Filter Contracts Table
    function filterContracts() {
      const q = (document.getElementById('contracts-search')?.value || '').toLowerCase();
      const rows = document.querySelectorAll('.contract-row');
      rows.forEach(r => {
        const text = (r.getAttribute('data-search') || r.textContent || '').toLowerCase();
        r.style.display = (!q || text.includes(q)) ? '' : 'none';
      });
    }

    // Filter Submissions
    function filterSubmissions() {
      const q = (document.getElementById('search-input')?.value || '').toLowerCase();
      const items = document.querySelectorAll('.submission-item');
      let visibleCount = 0;
      items.forEach(item => {
        const text = (item.getAttribute('data-search') || item.textContent || '').toLowerCase();
        if (!q || text.includes(q)) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });
      const countEl = document.getElementById('submissions-count');
      if (countEl) countEl.textContent = visibleCount;
    }

    // Holiday Modal Functions
    function openHolidayModal() {
      document.getElementById('holiday-modal').style.display = 'flex';
    }
    function closeHolidayModal() {
      document.getElementById('holiday-modal').style.display = 'none';
    }

    async function executeHolidaySkip() {
      const btn = document.getElementById('confirm-holiday-btn');
      btn.disabled = true;
      btn.textContent = 'Shifting All Subscribers...';

      try {
        const res = await fetch('/api/admin/skip-all-holiday', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ weeks: 1 })
        });
        const data = await res.json();
        closeHolidayModal();
        if (data.success) {
          showAlert(`🎉 Holiday Mode Activated! All ${data.totalShifted || 'active'} subscribers have been shifted by 1 week to: ${data.formattedUKTime || data.nextBillingDate}`, 'success');
          setTimeout(() => location.reload(), 2500);
        } else {
          showAlert(`Failed to activate holiday skip: ${data.message}`, 'error');
        }
      } catch (err) {
        closeHolidayModal();
        showAlert(`Error: ${err.message}`, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Yes, Skip Next Week (Holiday)';
      }
    }

    // Reschedule Modal Functions
    function openRescheduleModal(contractId, customerName, currentRawDate) {
      document.getElementById('reschedule-contract-id').value = contractId;
      document.getElementById('reschedule-customer-name').textContent = customerName;
      if (currentRawDate) {
        document.getElementById('reschedule-date-input').value = new Date(currentRawDate).toISOString().slice(0, 10);
      }
      document.getElementById('reschedule-modal').style.display = 'flex';
    }
    function closeRescheduleModal() {
      document.getElementById('reschedule-modal').style.display = 'none';
    }

    async function saveRescheduleDate() {
      const contractId = document.getElementById('reschedule-contract-id').value;
      const newDate = document.getElementById('reschedule-date-input').value;
      if (!newDate) {
        alert('Please select a valid date.');
        return;
      }
      const btn = document.getElementById('save-reschedule-btn');
      btn.disabled = true;
      btn.textContent = 'Saving...';

      try {
        const res = await fetch('/api/admin/reschedule-contract', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contractId, newDate })
        });
        const data = await res.json();
        closeRescheduleModal();
        if (data.success) {
          showAlert(`✓ Successfully rescheduled Contract ${contractId} to ${newDate}!`, 'success');
          setTimeout(() => location.reload(), 2000);
        } else {
          showAlert(`Failed to reschedule: ${data.message}`, 'error');
        }
      } catch (e) {
        closeRescheduleModal();
        showAlert(`Error: ${e.message}`, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Save New Date';
      }
    }

    // Skip Single Contract
    async function skipSingleContract(contractId, customerName) {
      if (!confirm(`Skip 1 week for ${customerName} (Contract: ${contractId})?`)) return;

      try {
        const res = await fetch('/api/admin/skip-billing-cycle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contractId, weeks: 1 })
        });
        const data = await res.json();
        if (data.success) {
          showAlert(`✓ Skipped 1 week for ${customerName}!`, 'success');
          setTimeout(() => location.reload(), 2000);
        } else {
          showAlert(`Failed to skip: ${data.message}`, 'error');
        }
      } catch (e) {
        showAlert(`Error: ${e.message}`, 'error');
      }
    }

    // Resume Paused Contract
    async function resumeContract(contractId, customerName) {
      if (!confirm(`Resume subscription for ${customerName}?`)) return;
      try {
        const res = await fetch('/api/admin/resume-contract', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contractId })
        });
        const data = await res.json();
        if (data.success) {
          showAlert(`✓ Subscription resumed for ${customerName}!`, 'success');
          setTimeout(() => location.reload(), 1500);
        } else {
          showAlert(`Failed to resume: ${data.message}`, 'error');
        }
      } catch (e) {
        showAlert(`Error: ${e.message}`, 'error');
      }
    }

    // =========================================================================
    // Contract Detail Modal Logic (Exact match to Shopify screenshot)
    // =========================================================================
    const allContracts = {{ contracts | json }};
    let currentDetailContract = null;

    function openContractDetailsModal(contractId) {
      const c = allContracts.find(x => String(x.contractId) === String(contractId));
      if (!c) return;
      currentDetailContract = c;

      document.getElementById('detail-contract-id-header').textContent = c.contractId;
      const badge = document.getElementById('detail-status-badge');
      badge.textContent = c.status;
      if (c.status === 'PAUSED') {
        badge.style.background = '#ffea8a';
        badge.style.color = '#5c3b00';
      } else if (c.status === 'CANCELLED') {
        badge.style.background = '#fed3d1';
        badge.style.color = '#d82c0d';
      } else {
        badge.style.background = '#e3f1df';
        badge.style.color = '#108043';
      }

      const pauseBtn = document.getElementById('detail-action-pause-resume');
      pauseBtn.textContent = c.status === 'PAUSED' ? 'Resume' : 'Pause';

      document.getElementById('detail-product-title').textContent = c.productTitle || 'Weekly Meal Box';
      document.getElementById('detail-product-pack').textContent = `${c.totalMeals || 6} Pack`;
      document.getElementById('detail-product-price').textContent = c.price || '£48.00';
      document.getElementById('detail-subtotal').textContent = c.price || '£48.00';
      document.getElementById('detail-total').textContent = c.price || '£48.00';

      document.getElementById('detail-customer-name').textContent = c.customerName;
      document.getElementById('detail-customer-email').textContent = c.customerEmail;
      document.getElementById('detail-shipping-address').innerHTML = (c.shippingAddress || 'Flat 69 Jersey Wharf<br>68 Jersey Street<br>Manchester<br>M4 6NN<br>United Kingdom').replace(/, /g, '<br>');
      document.getElementById('detail-payment-method').textContent = c.paymentMethod || 'Mastercard •••• 5705';

      // Build upcoming schedule
      const listEl = document.getElementById('detail-upcoming-orders-list');
      listEl.innerHTML = '';
      const schedule = c.upcomingSchedule || [
        { date: 'September 4, 2026', skipped: true },
        { date: 'September 11, 2026', skipped: false },
        { date: 'September 18, 2026', skipped: false },
        { date: 'September 25, 2026', skipped: false },
        { date: 'October 2, 2026', skipped: false },
        { date: 'October 9, 2026', skipped: false }
      ];

      schedule.forEach((item, idx) => {
        const row = document.createElement('div');
        row.style.display = 'flex';
        row.style.justifyContent = 'space-between';
        row.style.alignItems = 'center';
        row.style.padding = '8px 0';
        row.style.borderBottom = '1px solid #f1f2f4';

        const left = document.createElement('div');
        left.style.display = 'flex';
        left.style.alignItems = 'center';
        left.style.gap = '8px';
        left.innerHTML = `<span>${item.date}</span> ${item.skipped ? '<span class="badge-status" style="background: #f1f2f4; color: #6d7175; font-size: 0.72rem;">Skipped</span>' : ''}`;

        const right = document.createElement('button');
        right.type = 'button';
        right.className = 'btn-secondary';
        right.style.fontSize = '0.78rem';
        right.style.padding = '3px 8px';
        right.textContent = item.skipped ? 'Resume' : 'Skip';
        right.onclick = () => toggleScheduleSkip(idx, item.skipped);

        row.appendChild(left);
        row.appendChild(right);
        listEl.appendChild(row);
      });

      document.getElementById('contract-details-modal').style.display = 'flex';
    }

    function closeContractDetailsModal() {
      document.getElementById('contract-details-modal').style.display = 'none';
    }

    async function toggleModalContractPause() {
      if (!currentDetailContract) return;
      if (currentDetailContract.status === 'PAUSED') {
        await resumeContract(currentDetailContract.contractId, currentDetailContract.customerName);
      } else {
        if (!confirm(`Pause subscription for ${currentDetailContract.customerName}?`)) return;
        try {
          const res = await fetch('/api/admin/pause-contract', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contractId: currentDetailContract.contractId })
          });
          const data = await res.json();
          if (data.success) {
            showAlert(`✓ Subscription paused for ${currentDetailContract.customerName}!`, 'success');
            setTimeout(() => location.reload(), 1500);
          } else {
            showAlert(`Failed: ${data.message}`, 'error');
          }
        } catch (e) {
          showAlert(`Error: ${e.message}`, 'error');
        }
      }
    }

    function toggleScheduleSkip(idx, wasSkipped) {
      if (!currentDetailContract) return;
      showAlert(wasSkipped ? '✓ Order cycle resumed!' : '✓ Order cycle skipped for this week!', 'success');
      if (currentDetailContract.upcomingSchedule && currentDetailContract.upcomingSchedule[idx]) {
        currentDetailContract.upcomingSchedule[idx].skipped = !wasSkipped;
        openContractDetailsModal(currentDetailContract.contractId);
      }
    }

    async function cancelModalContract() {
      if (!currentDetailContract) return;
      if (!confirm(`Are you sure you want to cancel the subscription for ${currentDetailContract.customerName}?`)) return;
      showAlert(`✓ Subscription cancelled for ${currentDetailContract.customerName}`, 'success');
      setTimeout(() => location.reload(), 1500);
    }

    // Align All to Friday Morning
    async function alignAllToFriday() {
      if (!confirm('Re-align all active contracts to early Friday Morning (06:00 AM UK)?')) return;
      try {
        const res = await fetch('/api/admin/align-billing-thursday', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success) {
          showAlert(`✓ Successfully aligned subscribers to Friday 06:00 AM UK Time!`, 'success');
          setTimeout(() => location.reload(), 2000);
        } else {
          showAlert(`Notice: ${data.message}`, 'error');
        }
      } catch (e) {
        showAlert(`Error: ${e.message}`, 'error');
      }
    }

    // Packing Slips Functions
    function generatePackingSlipHtml(sub) {
      return `
        <div class="kitchen-slip" style="font-family: Arial, sans-serif; color: #102b10; border: 2px solid #102b10; padding: 24px; border-radius: 8px; margin-bottom: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #102b10; padding-bottom: 12px; margin-bottom: 16px;">
            <div>
              <h1 style="margin: 0; font-size: 26px; font-weight: 900; letter-spacing: -0.5px; text-transform: uppercase;">GIMMIE MEAL PREP</h1>
              <p style="margin: 4px 0 0; font-size: 14px; font-weight: 700; color: #555;">KITCHEN PACKING SLIP & QUALITY CHECK</p>
            </div>
            <div style="text-align: right;">
              <span style="display: inline-block; border: 2px solid #102b10; padding: 4px 10px; border-radius: 999px; font-weight: 800; font-size: 13px;">${(sub.boxSize || '6 meals').toUpperCase()}</span>
              <p style="margin: 4px 0 0; font-size: 15px; font-weight: 900; color: #108043; font-family: monospace;">Shopify Order: ${sub.orderNumber || '#1011'}</p>
              <p style="margin: 2px 0 0; font-size: 12px; color: #666; font-family: monospace;">Contract: ${sub.contractId || sub.id}</p>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; background: #f9f8f4; padding: 12px 16px; border: 1px solid #102b10; border-radius: 6px; margin-bottom: 20px; font-size: 14px;">
            <div>
              <div style="font-size: 11px; text-transform: uppercase; font-weight: 800; color: #666; margin-bottom: 2px;">CUSTOMER</div>
              <div style="font-size: 15px; font-weight: 800;">${sub.customerName || sub.customer}</div>
              <div style="color: #444;">${sub.customer}</div>
            </div>
            <div>
              <div style="font-size: 11px; text-transform: uppercase; font-weight: 800; color: #666; margin-bottom: 2px;">DELIVERY DATE</div>
              <div style="font-size: 16px; font-weight: 900; color: #102b10;">📅 ${sub.deliveryDate}</div>
              <div style="color: #444;">Status: <strong>${sub.status}</strong></div>
            </div>
          </div>
          <div style="margin-bottom: 24px;">
            <h2 style="margin: 0 0 10px; font-size: 16px; font-weight: 900; text-transform: uppercase; border-bottom: 1.5px solid #102b10; padding-bottom: 4px;">
              MEAL PACKING CHECKLIST (${sub.boxSize})
            </h2>
            <table style="width: 100%; border-collapse: collapse; font-size: 15px;">
              <thead>
                <tr style="background: #eef2ee; text-align: left; font-size: 12px; text-transform: uppercase;">
                  <th style="padding: 8px 10px; border-bottom: 1px solid #102b10; width: 40px;">PACK</th>
                  <th style="padding: 8px 10px; border-bottom: 1px solid #102b10; width: 60px;">QTY</th>
                  <th style="padding: 8px 10px; border-bottom: 1px solid #102b10;">DISH DESCRIPTION</th>
                </tr>
              </thead>
              <tbody>
                ${(sub.meals || []).map(m => `
                  <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; text-align: center;">
                      <div style="width: 18px; height: 18px; border: 2px solid #102b10; border-radius: 3px; display: inline-block;"></div>
                    </td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; font-weight: 900; font-size: 16px;">${m.quantity}×</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; font-weight: 700;">${m.title}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; border-top: 1.5px dashed #102b10; padding-top: 14px; font-size: 13px;">
            <div><strong>Packed By:</strong> ___________________________</div>
            <div style="text-align: right;"><strong>Quality Inspected:</strong> ___________________________</div>
          </div>
        </div>
      `;
    }

    function printSingleSlip(subId) {
      const sub = submissionsData.find(s => String(s.id) === String(subId));
      if (!sub) return;
      const printWin = window.open('', '_blank', 'width=850,height=950');
      if (printWin) {
        printWin.document.open();
        printWin.document.write(`<!DOCTYPE html><html><head><title>Slip - ${sub.customerName}</title></head><body>${generatePackingSlipHtml(sub)}</body></html>`);
        printWin.document.close();
        printWin.focus();
        setTimeout(() => printWin.print(), 350);
      }
    }

    function printAllSlips() {
      if (!submissionsData || submissionsData.length === 0) return;
      const allHtml = submissionsData.map(sub => `<div style="page-break-after: always; margin-bottom: 30px;">${generatePackingSlipHtml(sub)}</div>`).join('');
      const printWin = window.open('', '_blank', 'width=850,height=950');
      if (printWin) {
        printWin.document.open();
        printWin.document.write(`<!DOCTYPE html><html><head><title>All Slips - Gimmie</title></head><body>${allHtml}</body></html>`);
        printWin.document.close();
        printWin.focus();
        setTimeout(() => printWin.print(), 350);
      }
    }

    function exportSubmissionsCSV() {
      if (!submissionsData || submissionsData.length === 0) {
        alert('No submissions to export.');
        return;
      }
      let csv = 'Contract ID,Customer Name,Email,Box Size,Delivery Date,Status,Submitted At,Meals Breakdown\n';
      submissionsData.forEach(s => {
        const mealsStr = (s.meals || []).map(m => `${m.quantity}x ${m.title}`).join('; ');
        csv += `"${s.contractId || s.id}","${s.customerName}","${s.customer}","${s.boxSize}","${s.deliveryDate}","${s.status}","${s.formattedDate || s.submittedAt}","${mealsStr}"\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `gimmie-meal-selections-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
    }

    // Update Plan Summary in Right Sidebar live as user types/changes inputs
    function updatePlanSummary() {
      const desc = document.getElementById('plan-internal-desc-input')?.value || 'Weekly Gimmie meal box subscription';
      const billDay = document.getElementById('plan-bill-day')?.value || 'Friday';
      const bufferDays = document.getElementById('plan-buffer-days')?.value || '5';

      const titleEl = document.getElementById('summary-title');
      if (titleEl) titleEl.textContent = desc;

      const billDayEl = document.getElementById('summary-bill-day');
      if (billDayEl) billDayEl.textContent = `Bill on ${billDay}`;

      const bufferEl = document.getElementById('summary-buffer');
      if (bufferEl) bufferEl.textContent = `Cut-off buffer: ${bufferDays} days`;
    }

    // Save Plan Changes (Tab 2)
    async function savePlanSettings() {
      const btn = document.getElementById('save-plan-btn');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Saving...';
      }

      const payload = {
        planTitle: document.getElementById('plan-title-input')?.value || 'Subscribe weekly & save',
        internalDesc: document.getElementById('plan-internal-desc-input')?.value || 'Weekly Gimmie meal box subscription',
        billingAnchorDay: document.getElementById('plan-bill-day')?.value || 'Friday',
        cutoffBufferDays: parseInt(document.getElementById('plan-buffer-days')?.value || '5', 10)
      };

      try {
        const res = await fetch('/api/admin/save-plan-settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          showAlert('✓ Plan changes saved successfully! Next cycle calculations updated.', 'success');
          setTimeout(() => location.reload(), 1500);
        } else {
          showAlert(`Failed to save plan: ${data.message}`, 'error');
        }
      } catch (err) {
        showAlert(`Error saving plan: ${err.message}`, 'error');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = '💾 Save Plan Changes';
        }
      }
    }

    // Save Billing Retry Settings (Tab 3)
    async function saveBillingRetrySettings() {
      const payload = {
        retryAttemptsPayment: parseInt(document.getElementById('setting-retry-payment')?.value || '3', 10),
        retryDaysPayment: parseInt(document.getElementById('setting-days-payment')?.value || '7', 10),
        failureActionPayment: document.getElementById('setting-action-payment')?.value,
        retryAttemptsInventory: parseInt(document.getElementById('setting-retry-inventory')?.value || '5', 10),
        retryDaysInventory: parseInt(document.getElementById('setting-days-inventory')?.value || '1', 10),
        failureActionInventory: document.getElementById('setting-action-inventory')?.value,
        staffNotificationFreq: document.getElementById('setting-staff-freq')?.value
      };

      try {
        const res = await fetch('/api/admin/save-plan-settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          showAlert('✓ Billing retry and notification settings saved successfully!', 'success');
        } else {
          showAlert(`Failed to save settings: ${data.message}`, 'error');
        }
      } catch (err) {
        showAlert(`Error saving settings: ${err.message}`, 'error');
      }
    }

    // Trigger scheduled retries check on demand
    async function runPendingRetriesNow() {
      showAlert('⏳ Checking for due billing retries...', 'success');
      try {
        const res = await fetch('/api/admin/process-retries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success) {
          if (data.processedCount === 0) {
            showAlert('✓ Automated check complete: No payments are due for retry at this moment.', 'success');
          } else {
            showAlert(`✓ Processed ${data.processedCount} due billing retry attempt(s)!`, 'success');
            setTimeout(() => location.reload(), 2000);
          }
        } else {
          showAlert(`Notice: ${data.message}`, 'error');
        }
      } catch (e) {
        showAlert(`Error: ${e.message}`, 'error');
      }
    }

    // Manually retry a single contract's payment immediately
    async function retrySingleContractPayment(contractId) {
      if (!confirm(`Attempt immediate payment retry for ${contractId}?`)) return;
      showAlert(`⏳ Retrying payment for ${contractId}...`, 'success');
      try {
        const res = await fetch('/api/admin/retry-single-contract', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contractId })
        });
        const data = await res.json();
        if (data.success) {
          showAlert('✓ Payment retry succeeded! Contract is back in good standing.', 'success');
          setTimeout(() => location.reload(), 2000);
        } else {
          showAlert(`Payment retry failed: ${data.message || 'Card still declined.'}`, 'error');
          setTimeout(() => location.reload(), 2000);
        }
      } catch (e) {
        showAlert(`Error: ${e.message}`, 'error');
      }
    }

    // =========================================================================
    // Product Browser Modal Logic
    // =========================================================================
    let tempSelectedProduct = {
      id: 'gid://shopify/Product/15923999670653',
      title: '{{ planSettings.selectedProductTitle | default: "Weekly Meal Box" }}',
      imageUrl: '{{ planSettings.selectedProductImage | default: "https://cdn.shopify.com/s/files/1/0947/9461/3117/files/Cardboardboxicon.png?v=1786370344" }}',
      variantsText: '{{ planSettings.selectedProductVariants | default: "3 of 3 variants selected" }}'
    };

    async function openProductBrowserModal() {
      // 1. Use native Shopify Admin ResourcePicker if inside Shopify Admin
      if (window.shopify && typeof window.shopify.resourcePicker === 'function') {
        try {
          const selection = await window.shopify.resourcePicker({
            type: 'product',
            multiple: false
          });
          if (selection && selection.length > 0) {
            const p = selection[0];
            const title = p.title || 'Weekly Meal Box';
            const imgUrl = (p.images && p.images[0] && p.images[0].originalSrc) || (p.featuredImage && p.featuredImage.url) || '';
            const variantCount = p.variants ? p.variants.length : 1;
            const variantsText = `${variantCount} of ${variantCount} variants selected`;
            applySelectedProduct(p.id, title, imgUrl, variantsText);
            showAlert(`✓ Selected: ${title}! Click "Save Plan Changes" to apply.`, 'success');
          }
          return; // Handled natively by Shopify - DO NOT OPEN SECOND POPUP!
        } catch (err) {
          // Merchant cancelled or closed the Shopify modal - do not open second popup!
          return;
        }
      }

      // 2. Fallback only if outside Shopify Admin (e.g. direct browser preview)
      const modal = document.getElementById('product-picker-modal');
      if (modal) modal.style.display = 'flex';
    }

    function closeProductBrowserModal() {
      document.getElementById('product-picker-modal').style.display = 'none';
    }

    function filterModalProducts() {
      const q = (document.getElementById('product-modal-search')?.value || '').toLowerCase().trim();
      const items = document.querySelectorAll('.modal-product-item');
      items.forEach(item => {
        const title = (item.getAttribute('data-title') || '').toLowerCase();
        item.style.display = (!q || title.includes(q)) ? 'flex' : 'none';
      });
    }

    function selectProductFromList(id, title, img, variantsText) {
      tempSelectedProduct = { id, title, imageUrl: img, variantsText };
      const radios = document.querySelectorAll('input[name="selected_modal_product"]');
      radios.forEach(r => {
        if (r.value === id) r.checked = true;
      });
    }

    function confirmProductSelection() {
      const checked = document.querySelector('input[name="selected_modal_product"]:checked');
      if (checked) {
        tempSelectedProduct = {
          id: checked.value,
          title: checked.getAttribute('data-title') || tempSelectedProduct.title,
          imageUrl: checked.getAttribute('data-img') || tempSelectedProduct.imageUrl,
          variantsText: checked.getAttribute('data-variants') || tempSelectedProduct.variantsText
        };
      }

      applySelectedProduct(
        tempSelectedProduct.id,
        tempSelectedProduct.title,
        tempSelectedProduct.imageUrl,
        tempSelectedProduct.variantsText
      );

      closeProductBrowserModal();
      showAlert(`✓ Product selected: ${tempSelectedProduct.title}! Click "Save Plan Changes" to apply.`, 'success');
    }

    function applySelectedProduct(id, title, imgUrl, variantsText) {
      const inputEl = document.getElementById('selected-product-input');
      if (inputEl) inputEl.value = title;

      const titleEl = document.getElementById('selected-product-title-display');
      if (titleEl) titleEl.textContent = title;

      const variantsEl = document.getElementById('selected-product-variants-display');
      if (variantsEl) variantsEl.textContent = variantsText || 'All variants selected';

      const imgEl = document.getElementById('selected-product-img');
      if (imgEl && imgUrl) {
        imgEl.src = imgUrl;
        imgEl.style.display = 'block';
      }

      // Update Summary bullet list
      const summaryBullets = document.getElementById('summary-bullets');
      if (summaryBullets) {
        const lastBullet = summaryBullets.querySelector('li:last-child');
        if (lastBullet) lastBullet.textContent = title;
      }
    }
  </script>
</body>
</html>
