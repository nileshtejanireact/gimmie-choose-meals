{% render 'styles-inline' %}

<section class="gimmie-build-box">
  <div class="gimmie-build-box__section">
    <div class="gimmie-build-box__inner" style="max-width: 650px;">
      <div class="gimmie-build-box__panel">
        <div class="gimmie-build-box__surface" style="text-align: center;">
          <div style="display: inline-flex; align-items: center; justify-content: center; width: 68px; height: 68px; border: 2.5px solid var(--gimmie-border); border-radius: 999px; background: var(--gimmie-accent); font-size: 2rem; font-weight: 900; margin-bottom: 20px;">
            🍽️
          </div>
          <h1 class="gimmie-build-box__panel-title" style="margin-bottom: 12px;">No Active Subscription Found</h1>
          <p class="gimmie-build-box__description" style="font-size: 1.05rem; margin-bottom: 24px;">
            Hi {{ customer.firstName | default: 'there' }}! We couldn't find an active meal subscription on this account. Start a plan to choose your meals each week.
          </p>
          <a href="/collections/meal-plans" class="gimmie-build-box__button" style="max-width: 280px; margin: 0 auto;">
            View Meal Plans
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
